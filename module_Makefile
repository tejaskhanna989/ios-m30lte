# Makefile for xnu_loader kernel module
obj-m += xnu_loader.o

KDIR ?= /tmp/m30kernel/android_kernel_samsung_m30lte-master
ARCH ?= arm64
CROSS_COMPILE ?= aarch64-linux-gnu-

all:
	$(MAKE) -C $(KDIR) M=$(PWD) ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE) modules

clean:
	$(MAKE) -C $(KDIR) M=$(PWD) clean
