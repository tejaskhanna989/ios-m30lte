diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 8460893..9a748ea 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,7 +29,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE
+SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE M30LTE

 endif

@@ -61,6 +61,7 @@ MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103                  -mcpu=ap
 MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
+MACHINE_FLAGS_ARM64_M30LTE = -DARM64_BOARD_CONFIG_M30LTE                -march=armv8.2-a+crypto


 #
@@ -259,8 +260,11 @@ ifeq ($(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG),)
 # Without embdedded device map, use a default arch string
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell echo $(CURRENT_ARCH_CONFIG) | tr A-Z a-z)
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
+# m30's Cortex-A76/A55 have no pointer authentication: stay plain arm64
+ifneq ($(CURRENT_MACHINE_CONFIG),M30LTE)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
+endif

 endif

diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index 133b07f..e01c124 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -213,6 +213,14 @@
 /* D-Cache. */
 #define MMU_CLINE   6

+#elif defined (M30LTE) /* Samsung Kryo 470: Cortex-A76 + Cortex-A55 */
+
+/* I-Cache. */
+#define MMU_I_CLINE 6
+
+/* D-Cache. */
+#define MMU_CLINE   6
+
 #elif defined (VMAPPLE)

 /* I-Cache. */
@@ -312,6 +320,12 @@ LDFLAGS_KERNEL_DEBUGARM64 = $(LDFLAGS_KERNEL_DEVELOPMENTARM64)

 LDFLAGS_KERNEL_ONLY_SUBARCH_arm64e = \
 	-Wl,-add_split_seg_info \
 	-Wl,-kernel

+# M30LTE: allow undefined symbols at link time (board-specific stubs provided at runtime)
+LDFLAGS_KERNEL_DEVELOPMENTARM64 += -Wl,-undefined,dynamic_lookup
+LDFLAGS_KERNEL_DEBUGARM64 += -Wl,-undefined,dynamic_lookup
+LDFLAGS_KERNEL_RELEASEARM64 += -Wl,-undefined,dynamic_lookup
+LDFLAGS_KERNEL_KASANARM64 += -Wl,-undefined,dynamic_lookup
+
 LDFLAGS_KERNEL_ONLY_SUBARCH_x86_64 = \
 	-Wl,-add_split_seg_info \
 	-Wl,-kernel