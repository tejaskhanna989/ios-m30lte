+/* GICv3 register definitions */
+#define GICR_CTLR            0x004
+#define GICR_WAKER           0x014
+#define GICR_WAKER_PROCESSORSLEEP (1U << 0)
+#define GICR_WAKER_CHILDRENASLEEP (1U << 1)
+#define GICR_PE_SIZE         0x008
