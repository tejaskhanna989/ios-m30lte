+#define GICR_TYPER_AFFINITY_VALUE_SHIFT  0
+#define GICR_TYPER_LAST      (1U << 12)
+#define GICR_ISENABLER0      0x100
+#define GICD_CTLR            0x000
+#define GICD_CTLR_ENABLEGRP0 (1U << 0)
+#define GICD_CTLR_ARE_NS     (1U << 1)
+#define GICD_CTLR_ENABLEGRP1A (1U << 1)
+#define GICD_CTLR_ENABLEGRP1 (1U << 1)
+#define GICD_CTLR_RWP        (1U << 31)
+#define ICC_SRE_SRE          (1U << 0)
+#define ICC_CTLR_EOIMODE     (1U << 1)
+#define ICC_IGRPEN0_EL1      0
+#define ICC_IGRPEN1_EL1      0
+#define ICC_BPR0_EL1         0
+#define ICC_BPR1_EL1         0
+#define ICC_PMR_EL1          0
+#define ICC_CTLR_EL1         0
+#define ICC_IAR1_EL1         0
+#define ICC_EOIR1_EL1        0
+#define ICC_SRE_EL1          0
+#define ICC_SRE_ENABLE       (1U << 0)
+#define ICC_SRE_DFB          (1U << 1)
+#define ICC_SRE_TFB          (1U << 2)
+#define ICC_CTLR_EL1         0
+
+#define CPU_HAS_APPLE_PAC         0
+#define MAX_CPUS                       8
+#define MAX_L2_CLINE                   6
+#define MAX_CPU_CLUSTERS               2
+#define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
+#define HAS_PARAVIRTUALIZED_PAC   0
+#define HAS_GIC_V3                1
+
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
