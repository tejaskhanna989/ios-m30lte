+#ifndef ARM_PTE_XPRR_SHIFT
+#define ARM_PTE_XPRR_SHIFT   0
+#endif
+#ifndef ARM_PTE_XPRR_MASK
+#define ARM_PTE_XPRR_MASK    0
+#endif
