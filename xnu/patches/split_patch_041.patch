+/*
+ * XPRR (Extended Permission Register Register) permission values for non-Apple ARM64.
+ * These are Apple PPL-specific extensions. For non-PPL platforms, we map them
+ * to standard ARMv8-A PTE permission bits.
+ */
+#ifndef XPRR_KERN_RO_PERM
+#define XPRR_KERN_RO_PERM    0x0  /* Kernel read-only */
+#endif
+#ifndef XPRR_KERN_RW_PERM
+#define XPRR_KERN_RW_PERM    0x1  /* Kernel read-write */
+#endif
+#ifndef XPRR_KERN_RX_PERM
+#define XPRR_KERN_RX_PERM    0x2  /* Kernel read-execute */
+#endif
+#ifndef XPRR_PPL_RW_PERM
+#define XPRR_PPL_RW_PERM     0x3  /* PPL read-write (maps to kernel RW for non-PPL) */
+#endif
+#ifndef XPRR_PPL_RX_PERM
+#define XPRR_PPL_RX_PERM     0x4  /* PPL read-execute (maps to kernel RX for non-PPL) */
+#endif
+#ifndef XPRR_MAX_PERM
+#define XPRR_MAX_PERM        0x4
+#endif
+
+/*
+ * XPRR PTE bit definitions for non-PPL platforms.
+ * Apple's XPRR extension uses additional PTE bits. For non-PPL platforms,
+ * we define these as no-ops.
