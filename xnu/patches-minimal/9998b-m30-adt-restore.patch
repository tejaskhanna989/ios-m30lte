+static inline void
+m30_adt_hex(uint64_t v, unsigned int digits)
+{
+	static const char hx[] = "0123456789abcdef";
+	for (unsigned int i = 0; i < digits; i++) {
+		unsigned int sh = (digits - 1u - i) * 4u;
+		sweet_early_putc(hx[(v >> sh) & 0xfULL]);
+	}
+}
+
+static inline void
+m30_adt_str(const char *s)
+{
+	while (*s) {
+		sweet_early_putc(*s++);
+	}
+}
+
+static inline uint32_t
+m30_adt_mismatch_count(const volatile uint8_t *p, uint32_t n)
+{
+	uint32_t bad = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		if (p[i] != m30_adt_expected[i]) {
+			bad++;
+		}
+	}
+	return bad;
+}
+
+/*
+ * Cache maintenance over [dtp, dtp+dt_size) through the VA XNU actually uses.
+ * clean=0: DC IVAC (diagnostic). clean=1: DC CIVAC (after exact restore).
+ * CTR_EL0.DminLine is log2(line size in 4-byte words); 0b0001..0b0111 is
+ * accepted (8..512 byte lines). Anything else aborts without writing.
+ */
+static inline int
+m30_adt_dcache_op_range(const void *dtp, uint32_t dt_size, int clean)
+{
+	uint64_t ctr, dmin, line, mask, start, end, addr, sctlr;
+
+	__asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+	__asm__ volatile("mrs %0, sctlr_el1" : "=r"(sctlr));
+
+	dmin = (ctr >> 16) & 0xfULL;
+	m30_adt_str("\nM30 ADT CMO ");
+	m30_adt_str(clean ? "CIVAC" : "IVAC");
+	m30_adt_str(" CTR ");
+	m30_adt_hex(ctr, 16);
+	m30_adt_str(" DMIN ");
+	m30_adt_hex(dmin, 2);
+	m30_adt_str(" SCTLR ");
+	m30_adt_hex(sctlr, 16);
+
+	if (dmin < 1 || dmin > 7 || dt_size == 0) {
+		m30_adt_str(" BAD CTR/SIZE\n");
+		return -1;
+	}
+
+	line = 4ULL << dmin;
+	m30_adt_str(" LINE ");
+	m30_adt_hex(line, 4);
+	m30_adt_str("\n");
+
+	start = (uint64_t)(uintptr_t)dtp;
+	if (start > UINT64_MAX - (uint64_t)dt_size) {
+		m30_adt_str("M30 ADT CMO OVERFLOW\n");
+		return -1;
+	}
+	end = start + (uint64_t)dt_size;
+	mask = line - 1;
+	addr = start & ~mask;
+
+	if (end > UINT64_MAX - mask) {
+		m30_adt_str("M30 ADT CMO END OVERFLOW\n");
+		return -1;
+	}
+	end = (end + mask) & ~mask;
+
+	for (; addr < end; addr += line) {
+		if (clean) {
+			__asm__ volatile("dc civac, %0" : : "r"(addr) : "memory");
+		} else {
+			__asm__ volatile("dc ivac, %0" : : "r"(addr) : "memory");
+		}
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+
+	m30_adt_str("M30 ADT CMO RANGE ");
+	m30_adt_hex(start, 16);
+	m30_adt_str(" ");
+	m30_adt_hex(end, 16);
+	m30_adt_str("\n");
+	return 0;
+}
+
+/*
+ * Restore the exact packaged ADT when runtime bytes differ. Called after
+ * SecureDTInit() and immediately before pe_identify_machine().
+ */
+static inline void
+m30_adt_readback_impl(const void *dtp, uint32_t dt_size)
+{
+	const volatile uint8_t *p = (const volatile uint8_t *)dtp;
+	volatile uint8_t *w = (volatile uint8_t *)dtp;
+	uint64_t va, pa, sctlr;
+	uint32_t len_before, len_ivac, len_after, bad_before, bad_after;
+	unsigned int row, col;
+
+	if (dt_size < 64u) {
+		return;
+	}
+
+	va = (uint64_t)(uintptr_t)dtp;
+	pa = va - M30_ADT_KVA_DELTA;
+	__asm__ volatile("mrs %0, sctlr_el1" : "=r"(sctlr));
+
+	m30_adt_str("\nM30 ADT RB VA ");
+	m30_adt_hex(va, 16);
+	m30_adt_str(" PA ");
+	m30_adt_hex(pa, 16);
+	m30_adt_str(" SCTLR ");
+	m30_adt_hex(sctlr, 16);
+	m30_adt_str(" MAP=NormWB\n");
+
+	for (row = 0; row < 4u; row++) {
+		m30_adt_hex(row * 16u, 2);
+		m30_adt_str(": ");
+		for (col = 0; col < 16u; col++) {
+			uint8_t b = p[row * 16u + col];
+			m30_adt_hex(b, 2);
+			m30_adt_str(" ");
+		}
+		m30_adt_str("\n");
+	}
+
+	len_before = *(const volatile uint32_t *)(const void *)(p + 40u);
+	m30_adt_str("M30 ADT PROP0 LEN BEFORE ");
+	m30_adt_hex(len_before, 8);
+	m30_adt_str("\n");
+
+	if (dt_size != M30_ADT_EXPECTED_SIZE) {
+		m30_adt_str("M30 ADT RESTORE BAD SIZE\n");
+		return;
+	}
+	if ((pa & (M30_ADT_PA_ALIGN - 1ULL)) != 0 ||
+	    pa < M30_ADT_PHYS_BASE || pa >= M30_ADT_PHYS_LIMIT ||
+	    pa + (uint64_t)dt_size > M30_ADT_PHYS_LIMIT) {
+		m30_adt_str("M30 ADT RESTORE BAD PA\n");
+		return;
+	}
+	if (((uintptr_t)dtp & 3u) != 0u) {
+		m30_adt_str("M30 ADT RESTORE UNALIGNED VA\n");
+		return;
+	}
+
+	/* IVAC-only discriminator. This may drop a stale line; the exact restore
+	 * below always follows, so the parser still receives validated bytes. */
+	if (m30_adt_dcache_op_range(dtp, dt_size, 0) != 0) {
+		return;
+	}
+	len_ivac = *(const volatile uint32_t *)(const void *)(p + 40u);
+	m30_adt_str("M30 ADT PROP0 LEN AFTER IVAC ");
+	m30_adt_hex(len_ivac, 8);
+	m30_adt_str("\n");
+
+	/* Restore byte-for-byte through the alias the parser uses. */
+	bad_before = m30_adt_mismatch_count(p, dt_size);
+	m30_adt_str("M30 ADT RESTORE MISMATCH BEFORE ");
+	m30_adt_hex(bad_before, 8);
+	m30_adt_str("\n");
+	for (uint32_t i = 0; i < dt_size; i++) {
+		w[i] = m30_adt_expected[i];
+	}
+	__asm__ volatile("dsb sy" : : : "memory");
+
+	/* Clean + invalidate so the exact bytes reach DRAM and no stale line can
+	 * be refilled by the parser. */
+	if (m30_adt_dcache_op_range(dtp, dt_size, 1) != 0) {
+		return;
+	}
+
+	len_after = *(const volatile uint32_t *)(const void *)(p + 40u);
+	bad_after = m30_adt_mismatch_count(p, dt_size);
+	m30_adt_str("M30 ADT PROP0 LEN AFTER RESTORE ");
+	m30_adt_hex(len_after, 8);
+	m30_adt_str("\n");
+	m30_adt_str("M30 ADT RESTORE MISMATCH AFTER ");
+	m30_adt_hex(bad_after, 8);
+	m30_adt_str("\nM30 ADT RB DONE\n");
+
