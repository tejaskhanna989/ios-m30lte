+/*
+ * M30LTE pre-parser ADT integrity restore and differentiated diagnostic.
+ *
+ * This file is layered on the committed readback diagnostic and the 9999a
+ * invalidate-only experiment. It preserves the exact Apple XNU validation in
+ * pexpert/gen/device_tree.c: it neither changes nor bypasses any DT bounds
+ * check, and it does not enlarge the DT region.
+ *
+ * Why this exists
+ * ---------------
+ * Physical evidence proves that the bytes XNU reads at deviceTreeP+0x28 are
+ * not the packaged ADT length 0x0000000c (observations decode to ASCII "kmsg"
+ * on the baseline layout and "t ba" on the later diagnostic layout). The
+ * packaged ADT is structurally valid and byte-identical in every image. An
+ * invalidate-only (DC IVAC) candidate was built and flashed once without a
+ * conclusive post-flash observation; invalidating can discard the only good
+ * cached copy, so it is not a sufficient correction.
+ *
+ * Correction implemented here
+ * ---------------------------
+ * Before SecureDTFindEntry(), this code:
+ *   1. captures the exact bytes XNU will parse via the high-KVA alias;
+ *   2. performs DC IVAC over the ADT range as a diagnostic discriminator;
+ *   3. restores the byte-identical packaged ADT from a compile-time image in
+ *      the kernel through that same high-KVA alias;
+ *   4. performs DC CIVAC (clean + invalidate to PoC) over the aligned range;
+ *   5. re-reads and verifies the full 0x27c4-byte region before returning.
+ *
+ * The CIVAC is safe here because the region was just rewritten with the exact
+ * packaged bytes; no stale firmware data can be written back. The write loop
+ * is bounded by the validated size and touches only [deviceTreeP, +0x27c4).
+ *
+ * Safety properties
+ * -----------------
+ *   - deviceTreeP, deviceTreeLength and all boot_args fields are read-only.
+ *   - No mapping, page table, TTBR/TCR/MAIR/SCTLR write; SCTLR_EL1 and CTR_EL0
+ *     are read with MRS only.
+ *   - No write outside the validated ADT range. The aligned CIVAC end is
+ *     below the boot_args page for cache lines up to 512 bytes.
+ *   - Unsupported CTR_EL0.DminLine encodings abort before any write or CMO.
+ *   - The embedded byte image is the exact 10,180-byte packaged ADT, verified
+ *     offline by SHA256 and by a full XNU-semantics structural walk.
+ *
+ * M30LTE-specific assumptions (explicitly checked at runtime)
+ * -----------------------------------------------------------
+ *   KVA delta       = 0xffffffef86000000 (deviceTreeP -> ADT PA)
+ *   ADT size        = 0x27c4
+ *   ADT PA alignment= 16 KiB
+ *   RAM window      = [0x80000000, 0xbd900000)  (phys_base + mem_size)
+ *   first prop len  = 0x0000000c
+ */
+#ifndef _ARM64_SWEET_EARLY_ADT_READBACK_H_
+#define _ARM64_SWEET_EARLY_ADT_READBACK_H_
+
+#include <stdint.h>
