+/* The XCTest literal patch is the proven "pager is ready" gate.  Replay the
+ * one-shot diagnostics and reopen the DSC scan once, whether the literal was
+ * rewritten on the slow validation path or on the bitmap fast path. */
+static void
+m30_irt_retrigger_after_xctest(void)
+{
+	if (m30_xctest_patch_count == 0 || m30_irt_retriggered) {
+		return;
+	}
+	m30_irt_retriggered = 1;
+	m30_irt_state = M30_IRT_STATE_NEED_DSC;
+	m30_irt_file_offset = 0;
+	m30_irt_target_vp = (vnode_t)0;
+	m30_irt_sym_vmaddr = 0;
+	m30_irt_image_addr = 0;
+	m30_irt_base_map_cnt = 0;
+	m30_irt_base_map_addr = 0;
+	m30_irt_base_map_size = 0;
+	m30_irt_base_map_off = 0;
+	m30_irt_sym_map_cnt = 0;
+	m30_irt_sym_map_addr = 0;
+	m30_irt_sym_map_size = 0;
+	m30_irt_sym_map_fileoff = 0;
+	m30_irt_fallback_off = 0;
+	m30_irt_map_hits = 0;
+	m30_irt_map_tries = 0;
+	m30_irt_last_err = 0;
+	m30_irt_diag_seen = 0;
+	m30_irt_thread_started = 0;
+	printf("M30 IRT: retrigger after XCTEST patch (total %lu)\n",
+	    m30_xctest_patch_count);
+}
 
