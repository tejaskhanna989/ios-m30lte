diff --git a/osfmk/vm/vm_fault.c b/osfmk/vm/vm_fault.c
--- a/osfmk/vm/vm_fault.c
+++ b/osfmk/vm/vm_fault.c
@@ -233,6 +233,9 @@
 static unsigned long m30_cs_fail_pager = 0;
 static uint64_t  m30_cs_diag_seen = 0;
 
+/* Set by osfmk/kern/exception.c when a UI process aborts with an NS exception. */
+extern char m30_last_crash_reason[];
+
 #ifndef IO_NOCACHE
 #define IO_NOCACHE 0x0800       /* bsd/sys/vnode.h: do not touch UBC cache */
 #endif
@@ -1297,6 +1300,20 @@
 			    m30_cs_fail_io, m30_cs_fail_pager);
 		}
 	}
+
+	/* v60: keep one compact durable line every 10 minutes.  This stays near
+	 * the tail of the 16 KB pmsg ring even after hours of daemon noise, so a
+	 * late recovery pull still contains the final CS/IRT result and the last
+	 * UI crash reason. */
+	for (;;) {
+		delay(600000000);       /* 10 min */
+		printf("M30 SLOW: state=%d csblk=%lu csfail=%lu csvok=%lu "
+		    "cfa=%lu cfi=%lu cfp=%lu reason=%s\n",
+		    m30_irt_state, m30_cs_block_reads, m30_cs_block_read_fail,
+		    m30_cs_block_validated, m30_cs_fail_alloc, m30_cs_fail_io,
+		    m30_cs_fail_pager,
+		    m30_last_crash_reason[0] != '\0' ? m30_last_crash_reason : "none");
+	}
 }
 
 /* Called in the page-fault path: no vnode I/O, only in-memory patching. */
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -835,6 +835,10 @@
 void sweet_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode);
 static void sweet_crash_strings(const char *name);
 
+/* Durable copy of the first UI NS-exception reason, replayed by the v60
+ * slow heartbeat in vm_fault.c so a late pstore pull still sees it. */
+char m30_last_crash_reason[256];
+
 void
 sweet_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode)
 {
@@ -987,6 +991,13 @@
 					text[m] = 0;
 					if (strncmp(text, last, sizeof(last) - 1) != 0) {
 						printf("STR %s\n", text);
+						if (m30_last_crash_reason[0] == '\0' &&
+						    (strstr(text, "Exception") != NULL ||
+						     strstr(text, "exception") != NULL ||
+						     strstr(text, "reason") != NULL)) {
+							strlcpy(m30_last_crash_reason, text,
+							    sizeof(m30_last_crash_reason));
+						}
 						lines++;
 						strlcpy(last, text, sizeof(last));
 					}
