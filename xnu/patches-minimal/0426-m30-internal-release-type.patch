diff --git a/osfmk/vm/vm_fault.c b/osfmk/vm/vm_fault.c
index e799c9a..576d908 100644
--- a/osfmk/vm/vm_fault.c
+++ b/osfmk/vm/vm_fault.c
@@ -108,6 +108,8 @@
 
 #include <sys/codesign.h>
 #include <sys/code_signing.h>
+#include <sys/uio.h>         /* UIO_READ, UIO_SYSSPACE */
+#include <sys/kauth.h>       /* kauth_cred_get() */
 #include <sys/reason.h>
 #include <sys/signalvar.h>
 
@@ -140,9 +142,326 @@
 
 extern void throttle_lowpri_io(int);
 
+/* Local prototype: <sys/vnode.h> is not self-contained in this build. */
+extern int vn_rdwr(enum uio_rw, struct vnode *, caddr_t, int, off_t,
+    enum uio_seg, int, kauth_cred_t, int *, proc_t);
+
 extern struct vnode *vnode_pager_lookup_vnode(memory_object_t);
 
 
+
+/*
+ * M30 iOS userspace compatibility: os_variant_has_internal_content().
+ *
+ * LiveContainer's bypass of +[SpringBoardUI load] has two parts:
+ *   1. set _internal_release_type = 3 in libsystem_darwin.dylib (makes
+ *      os_variant_has_internal_content() return true), and
+ *   2. register an XCTestConfiguration Objective-C class.
+ * Patch 0425 handles part 2 by retargeting class-name literals.  This patch
+ * handles part 1 by locating the _internal_release_type global via the dyld
+ * shared cache local-symbol table and setting it to 3 (internal release) in
+ * the already-faulted page.  Only the in-memory page is modified; the file on
+ * disk is never written.  Strictly after cs_validate_page(); no check weakened.
+ */
+#define M30_IRT_STATE_NEED_DSC   0
+#define M30_IRT_STATE_NEED_SYM   1
+#define M30_IRT_STATE_HAVE_OFF   2
+#define M30_IRT_STATE_DONE       3
+#define M30_IRT_STATE_FAILED     4
+
+static int       m30_irt_state = M30_IRT_STATE_NEED_DSC;
+static uint64_t  m30_irt_file_offset = 0;
+static int       m30_irt_last_err = 0;
+static uint32_t  m30_irt_diag_seen = 0;
+static int       m30_irt_retriggered = 0;   /* replay once after XCTEST patch */
+
+/* One-shot diagnostics: every distinct failure reason is printed at most once
+ * so the ramoops pmsg ring is not flooded. */
+#define M30_IRT_DIAG(n, fmt, ...) do {                                  \
+    if ((m30_irt_diag_seen & (1U << (n))) == 0) {                      \
+        m30_irt_diag_seen |= (1U << (n));                              \
+        printf("M30 IRT diag %d: " fmt, (n), ##__VA_ARGS__);           \
+    }                                                                   \
+} while (0)
+
+static int
+m30_irt_read(vnode_t vp, uint64_t off, void *buf, size_t len)
+{
+	int resid = (int)len;
+	int err;
+
+	if (vp == NULL || len == 0 || len > INT_MAX) {
+		m30_irt_last_err = -1;
+		return -1;
+	}
+	err = vn_rdwr(UIO_READ, vp, (char *)buf, (int)len, (off_t)off,
+	    UIO_SYSSPACE, 0, kauth_cred_get(), &resid, NULL);
+	if (err != 0) {
+		m30_irt_last_err = err;
+		return -1;
+	}
+	if (resid != 0) {
+		m30_irt_last_err = -2;   /* short read */
+		return -1;
+	}
+	m30_irt_last_err = 0;
+	return 0;
+}
+
+static void
+m30_internal_release_fixup(vnode_t vp, memory_object_t pager,
+    uint64_t mo_offset, void *kaddr)
+{
+	static const char symname[] = "_internal_release_type";
+	char   *hdr = NULL;
+	char   *lsi = NULL;
+	char   *buf = NULL;
+	char   *maps = NULL;
+	vm_object_t backing = VM_OBJECT_NULL;
+	memory_object_offset_t backing_off = 0;
+	uint64_t ls_off = 0, sym_vmaddr = 0, file_off = 0;
+	uint32_t map_off = 0, map_cnt = 0, nlist_off = 0, nlist_cnt = 0;
+	uint32_t str_off = 0, str_size = 0;
+	uint32_t found_strx = 0;
+	size_t  chunk = 65536;
+	int     found = 0, i;
+
+	M30_IRT_DIAG(0, "enter state=%d vp=%p pager=%p mo=0x%llx "
+	    "kaddr[0:4]=%02x%02x%02x%02x\n", m30_irt_state, (void *)vp,
+	    (void *)pager, (unsigned long long)mo_offset,
+	    ((unsigned char *)kaddr)[0], ((unsigned char *)kaddr)[1],
+	    ((unsigned char *)kaddr)[2], ((unsigned char *)kaddr)[3]);
+
+	if (m30_irt_state >= M30_IRT_STATE_DONE || kaddr == NULL) {
+		return;
+	}
+
+	/* The dyld shared cache is normally mapped through the dyld pager, for
+	 * which vnode_pager_lookup_vnode() returns NULL.  Recover the real file
+	 * vnode through the pager's generic backing-object callback. */
+	if (vp == NULL && pager != NULL) {
+		if (memory_object_backing_object(pager, mo_offset,
+		    &backing, &backing_off) &&
+		    backing != VM_OBJECT_NULL && backing->pager != NULL) {
+			vp = vnode_pager_lookup_vnode(backing->pager);
+			M30_IRT_DIAG(1, "backing=%p backing_pager=%p -> vnode=%p "
+			    "boff=0x%llx\n", (void *)backing, (void *)backing->pager,
+			    (void *)vp, (unsigned long long)backing_off);
+		} else {
+			M30_IRT_DIAG(1, "no backing object (pager=%p)\n",
+			    (void *)pager);
+		}
+	}
+	if (vp == NULL) {
+		M30_IRT_DIAG(2, "no vnode, cannot parse DSC\n");
+		return;
+	}
+
+	/* Already know the file offset: patch when that page faults in. */
+	if (m30_irt_state == M30_IRT_STATE_HAVE_OFF) {
+		if (mo_offset <= m30_irt_file_offset &&
+		    mo_offset + PAGE_SIZE > m30_irt_file_offset) {
+			size_t po = (size_t)(m30_irt_file_offset - mo_offset);
+			if (po + sizeof(uint32_t) <= PAGE_SIZE) {
+				uint32_t *loc = (uint32_t *)((char *)kaddr + po);
+				printf("M30 IRT: patched _internal_release_type "
+				    "off 0x%llx (%u -> 3)\n",
+				    (unsigned long long)m30_irt_file_offset, *loc);
+				*loc = 3;
+				m30_irt_state = M30_IRT_STATE_DONE;
+			}
+		}
+		return;
+	}
+
+	/* Need DSC: probe vnode header for "dyld_v" magic. */
+	if (m30_irt_state == M30_IRT_STATE_NEED_DSC) {
+		hdr = kalloc_data(chunk, Z_NOWAIT);
+		if (hdr == NULL) {
+			return;
+		}
+		if (m30_irt_read(vp, 0, hdr, 96) != 0) {
+			M30_IRT_DIAG(3, "header probe read failed err=%d\n",
+			    m30_irt_last_err);
+			kfree_data(hdr, chunk);
+			return;
+		}
+		if (memcmp(hdr, "dyld_v", 6) != 0) {
+			M30_IRT_DIAG(4, "no dyld magic: %02x%02x%02x%02x\n",
+			    (unsigned char)hdr[0], (unsigned char)hdr[1],
+			    (unsigned char)hdr[2], (unsigned char)hdr[3]);
+			kfree_data(hdr, chunk);
+			return;
+		}
+		M30_IRT_DIAG(5, "DSC magic found at vnode=%p\n", (void *)vp);
+		m30_irt_state = M30_IRT_STATE_NEED_SYM;
+		kfree_data(hdr, chunk);
+	}
+
+	/* Need symbol: parse local symbol table via vnode reads. */
+	hdr = kalloc_data(chunk, Z_NOWAIT);
+	lsi = kalloc_data(chunk, Z_NOWAIT);
+	buf = kalloc_data(chunk, Z_NOWAIT);
+	maps = kalloc_data(chunk, Z_NOWAIT);
+	if (hdr == NULL || lsi == NULL || buf == NULL || maps == NULL) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	/* dyld_cache_header: mappingOffset@16, mappingCount@20,
+	 * localSymbolsOffset@72 (all little-endian). */
+	if (m30_irt_read(vp, 0, hdr, 96) != 0) {
+		M30_IRT_DIAG(6, "main header read failed err=%d\n",
+		    m30_irt_last_err);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	if (memcmp(hdr, "dyld_v", 6) != 0) {
+		M30_IRT_DIAG(7, "main header magic mismatch\n");
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	map_off   = *(uint32_t *)(hdr + 16);
+	map_cnt   = *(uint32_t *)(hdr + 20);
+	ls_off    = *(uint64_t *)(hdr + 72);
+	M30_IRT_DIAG(8, "header map_off=0x%x map_cnt=%u ls_off=0x%llx\n",
+	    map_off, map_cnt, (unsigned long long)ls_off);
+	if (ls_off == 0 || map_off == 0 || map_cnt == 0) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	/* dyld_cache_local_symbols_info@ls_off */
+	if (m30_irt_read(vp, ls_off, lsi, 24) != 0) {
+		M30_IRT_DIAG(9, "local symbols info read failed err=%d\n",
+		    m30_irt_last_err);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	nlist_off = *(uint32_t *)(lsi + 0);
+	nlist_cnt = *(uint32_t *)(lsi + 4);
+	str_off   = *(uint32_t *)(lsi + 8);
+	str_size  = *(uint32_t *)(lsi + 12);
+	M30_IRT_DIAG(10, "lsi nlist_off=0x%x cnt=%u str_off=0x%x size=%u\n",
+	    nlist_off, nlist_cnt, str_off, str_size);
+	if (nlist_cnt == 0 || str_size == 0) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	/* Find "_internal_release_type\0" in the string pool. */
+	for (uint64_t o = 0; o < str_size; o += chunk) {
+		size_t n = MIN(chunk, (size_t)(str_size - o));
+		if (m30_irt_read(vp, ls_off + str_off + o, buf, n) != 0) {
+			M30_IRT_DIAG(11, "string pool read failed off=0x%llx err=%d\n",
+			    (unsigned long long)(ls_off + str_off + o),
+			    m30_irt_last_err);
+			break;
+		}
+		for (size_t j = 0; j + sizeof(symname) <= n; j++) {
+			if (buf[j] == '_' &&
+			    memcmp(buf + j, symname, sizeof(symname) - 1) == 0 &&
+			    buf[j + sizeof(symname) - 1] == '\0') {
+				found_strx = (uint32_t)(o + j);
+				found = 1;
+				break;
+			}
+		}
+		if (found) {
+			break;
+		}
+	}
+	if (!found) {
+		M30_IRT_DIAG(12, "symbol name not found in string pool (size=%u)\n",
+		    str_size);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	M30_IRT_DIAG(13, "symbol name found strx=%u\n", found_strx);
+
+	/* Scan nlist_64 entries for n_strx == found_strx. */
+	found = 0;
+	for (uint64_t i = 0; i < nlist_cnt; i += (chunk / 16)) {
+		size_t cnt = MIN((uint64_t)(chunk / 16), (uint64_t)nlist_cnt - i);
+		if (m30_irt_read(vp, ls_off + nlist_off + i * 16, buf,
+		    cnt * 16) != 0) {
+			M30_IRT_DIAG(14, "nlist read failed off=0x%llx err=%d\n",
+			    (unsigned long long)(ls_off + nlist_off + i * 16),
+			    m30_irt_last_err);
+			break;
+		}
+		for (size_t j = 0; j < cnt; j++) {
+			if (*(uint32_t *)(buf + j * 16) == found_strx) {
+				sym_vmaddr = *(uint64_t *)(buf + j * 16 + 8);
+				found = 1;
+				break;
+			}
+		}
+		if (found) {
+			break;
+		}
+	}
+	if (!found || sym_vmaddr == 0) {
+		M30_IRT_DIAG(15, "symbol not found in nlist (strx=%u cnt=%u)\n",
+		    found_strx, nlist_cnt);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	M30_IRT_DIAG(16, "symbol vmaddr=0x%llx\n",
+	    (unsigned long long)sym_vmaddr);
+
+	/* dyld_cache_mapping_info: address@0,size@8,fileOffset@16 (32 B each). */
+	if (m30_irt_read(vp, map_off, maps,
+	    MIN(map_cnt, (uint32_t)(chunk / 32)) * 32) != 0) {
+		M30_IRT_DIAG(17, "mapping table read failed err=%d\n",
+		    m30_irt_last_err);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	found = 0;
+	for (i = 0; i < (int)MIN(map_cnt, (uint32_t)(chunk / 32)); i++) {
+		uint64_t maddr = *(uint64_t *)(maps + i * 32);
+		uint64_t msize = *(uint64_t *)(maps + i * 32 + 8);
+		if (sym_vmaddr >= maddr && sym_vmaddr < maddr + msize) {
+			file_off = *(uint64_t *)(maps + i * 32 + 16) +
+			    (sym_vmaddr - maddr);
+			found = 1;
+			break;
+		}
+	}
+	if (!found) {
+		M30_IRT_DIAG(18, "no mapping contains vmaddr 0x%llx (cnt=%u)\n",
+		    (unsigned long long)sym_vmaddr, map_cnt);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	m30_irt_file_offset = file_off;
+	m30_irt_state = M30_IRT_STATE_HAVE_OFF;
+	printf("M30 IRT: found _internal_release_type vmaddr 0x%llx "
+	    "file off 0x%llx\n", (unsigned long long)sym_vmaddr,
+	    (unsigned long long)file_off);
+
+	/* Patch immediately if the current page is the target. */
+	if (mo_offset <= file_off && mo_offset + PAGE_SIZE > file_off) {
+		size_t po = (size_t)(file_off - mo_offset);
+		if (po + sizeof(uint32_t) <= PAGE_SIZE) {
+			uint32_t *loc = (uint32_t *)((char *)kaddr + po);
+			printf("M30 IRT: patched _internal_release_type "
+			    "off 0x%llx (%u -> 3)\n",
+			    (unsigned long long)file_off, *loc);
+			*loc = 3;
+			m30_irt_state = M30_IRT_STATE_DONE;
+		}
+	}
+
+out:
+	if (hdr != NULL)  kfree_data(hdr, chunk);
+	if (lsi != NULL)  kfree_data(lsi, chunk);
+	if (buf != NULL)  kfree_data(buf, chunk);
+	if (maps != NULL) kfree_data(maps, chunk);
+}
+
 /*
  * M30 iOS userspace compatibility for +[SpringBoardUI load].
  *
@@ -7687,6 +8006,23 @@
 		/* Userspace class-name fix-up, strictly after validation. */
 		m30_xctest_probe_fixup(kaddr, mo_offset);
 
+		/* The ramoops pmsg ring wraps early in a deep iOS boot.  When the
+		 * SpringBoard-related XCTest literal is first patched, replay the
+		 * IRT state machine and its one-shot diagnostics once so the result
+		 * is visible in the captured log window. */
+		if (m30_xctest_patch_count != 0 && !m30_irt_retriggered) {
+			m30_irt_retriggered = 1;
+			m30_irt_state = M30_IRT_STATE_NEED_DSC;
+			m30_irt_file_offset = 0;
+			m30_irt_last_err = 0;
+			m30_irt_diag_seen = 0;
+			printf("M30 IRT: retrigger after XCTEST patch (total %lu)\n",
+			    m30_xctest_patch_count);
+		}
+
+		/* LiveContainer bypass part 2: _internal_release_type = 3 */
+		m30_internal_release_fixup(vnode, pager, mo_offset, kaddr);
+
 		if (block_buf != NULL) {
 			kfree_data(block_buf, CS_16K_BLOCK_SIZE);
 		}
