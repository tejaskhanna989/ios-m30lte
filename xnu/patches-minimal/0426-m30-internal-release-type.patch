diff --git a/osfmk/vm/vm_fault.c b/osfmk/vm/vm_fault.c
index e799c9a..758417f 100644
--- a/osfmk/vm/vm_fault.c
+++ b/osfmk/vm/vm_fault.c
@@ -108,6 +108,7 @@
 
 #include <sys/codesign.h>
 #include <sys/code_signing.h>
+#include <sys/vnode.h>       /* vn_rdwr() for DSC symbol lookup */
 #include <sys/reason.h>
 #include <sys/signalvar.h>
 
@@ -143,6 +144,230 @@ extern void throttle_lowpri_io(int);
 extern struct vnode *vnode_pager_lookup_vnode(memory_object_t);
 
 
+
+/*
+ * M30 iOS userspace compatibility: os_variant_has_internal_content().
+ *
+ * LiveContainer's bypass of +[SpringBoardUI load] has two parts:
+ *   1. set _internal_release_type = 3 in libsystem_darwin.dylib (makes
+ *      os_variant_has_internal_content() return true), and
+ *   2. register an XCTestConfiguration Objective-C class.
+ * Patch 0425 handles part 2 by retargeting class-name literals.  This patch
+ * handles part 1 by locating the _internal_release_type global via the dyld
+ * shared cache local-symbol table and setting it to 3 (internal release) in
+ * the already-faulted page.  Only the in-memory page is modified; the file on
+ * disk is never written.  Strictly after cs_validate_page(); no check weakened.
+ */
+#define M30_IRT_STATE_NEED_DSC   0
+#define M30_IRT_STATE_NEED_SYM   1
+#define M30_IRT_STATE_HAVE_OFF   2
+#define M30_IRT_STATE_DONE       3
+#define M30_IRT_STATE_FAILED     4
+
+static int       m30_irt_state = M30_IRT_STATE_NEED_DSC;
+static uint64_t  m30_irt_file_offset = 0;
+
+static int
+m30_irt_read(vnode_t vp, uint64_t off, void *buf, size_t len)
+{
+	int resid = (int)len;
+
+	if (vp == NULL || len == 0 || len > INT_MAX) {
+		return -1;
+	}
+	if (vn_rdwr(UIO_READ, vp, (char *)buf, (int)len, (off_t)off,
+	    UIO_SYSSPACE, 0, kauth_cred_get(), &resid, NULL) != 0) {
+		return -1;
+	}
+	return (resid == 0) ? 0 : -1;
+}
+
+static void
+m30_internal_release_fixup(vnode_t vp, uint64_t mo_offset, void *kaddr)
+{
+	static const char symname[] = "_internal_release_type";
+	char   *hdr = NULL;
+	char   *lsi = NULL;
+	char   *buf = NULL;
+	char   *maps = NULL;
+	uint64_t ls_off, map_off, sym_vmaddr = 0, file_off = 0;
+	uint32_t map_cnt, nlist_off, nlist_cnt, str_off, str_size;
+	uint32_t found_strx = 0;
+	size_t  chunk = 65536;
+	int     found = 0, i;
+
+	if (m30_irt_state >= M30_IRT_STATE_DONE || vp == NULL || kaddr == NULL) {
+		return;
+	}
+
+	/* Already know the file offset: patch when that page faults in. */
+	if (m30_irt_state == M30_IRT_STATE_HAVE_OFF) {
+		if (mo_offset <= m30_irt_file_offset &&
+		    mo_offset + PAGE_SIZE > m30_irt_file_offset) {
+			size_t po = (size_t)(m30_irt_file_offset - mo_offset);
+			if (po + sizeof(uint32_t) <= PAGE_SIZE) {
+				uint32_t *loc = (uint32_t *)((char *)kaddr + po);
+				printf("M30 IRT: patched _internal_release_type "
+				    "off 0x%llx (%u -> 3)\n",
+				    (unsigned long long)m30_irt_file_offset, *loc);
+				*loc = 3;
+				m30_irt_state = M30_IRT_STATE_DONE;
+			}
+		}
+		return;
+	}
+
+	/* Need DSC: probe vnode header for "dyld_v" magic. */
+	if (m30_irt_state == M30_IRT_STATE_NEED_DSC) {
+		hdr = kalloc_data(chunk, Z_NOWAIT);
+		if (hdr == NULL) {
+			return;
+		}
+		if (m30_irt_read(vp, 0, hdr, 96) == 0 &&
+		    memcmp(hdr, "dyld_v", 6) == 0) {
+			m30_irt_state = M30_IRT_STATE_NEED_SYM;
+		}
+		kfree_data(hdr, chunk);
+		if (m30_irt_state != M30_IRT_STATE_NEED_SYM) {
+			return;
+		}
+	}
+
+	/* Need symbol: parse local symbol table via vnode reads. */
+	hdr = kalloc_data(chunk, Z_NOWAIT);
+	lsi = kalloc_data(chunk, Z_NOWAIT);
+	buf = kalloc_data(chunk, Z_NOWAIT);
+	maps = kalloc_data(chunk, Z_NOWAIT);
+	if (hdr == NULL || lsi == NULL || buf == NULL || maps == NULL) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	/* dyld_cache_header: mappingOffset@16, mappingCount@20,
+	 * localSymbolsOffset@72 (all little-endian). */
+	if (m30_irt_read(vp, 0, hdr, 96) != 0 ||
+	    memcmp(hdr, "dyld_v", 6) != 0) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	map_off   = *(uint32_t *)(hdr + 16);
+	map_cnt   = *(uint32_t *)(hdr + 20);
+	ls_off    = *(uint64_t *)(hdr + 72);
+	if (ls_off == 0 || map_off == 0 || map_cnt == 0) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	/* dyld_cache_local_symbols_info@ls_off */
+	if (m30_irt_read(vp, ls_off, lsi, 24) != 0) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	nlist_off = *(uint32_t *)(lsi + 0);
+	nlist_cnt = *(uint32_t *)(lsi + 4);
+	str_off   = *(uint32_t *)(lsi + 8);
+	str_size  = *(uint32_t *)(lsi + 12);
+	if (nlist_cnt == 0 || str_size == 0) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	/* Find "_internal_release_type\0" in the string pool. */
+	for (uint64_t o = 0; o < str_size; o += chunk) {
+		size_t n = MIN(chunk, (size_t)(str_size - o));
+		if (m30_irt_read(vp, ls_off + str_off + o, buf, n) != 0) {
+			break;
+		}
+		for (size_t j = 0; j + sizeof(symname) <= n; j++) {
+			if (buf[j] == '_' &&
+			    memcmp(buf + j, symname, sizeof(symname) - 1) == 0 &&
+			    buf[j + sizeof(symname) - 1] == '\0') {
+				found_strx = (uint32_t)(o + j);
+				found = 1;
+				break;
+			}
+		}
+		if (found) {
+			break;
+		}
+	}
+	if (!found) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	/* Scan nlist_64 entries for n_strx == found_strx. */
+	found = 0;
+	for (uint64_t i = 0; i < nlist_cnt; i += (chunk / 16)) {
+		size_t cnt = MIN((uint64_t)(chunk / 16), (uint64_t)nlist_cnt - i);
+		if (m30_irt_read(vp, ls_off + nlist_off + i * 16, buf,
+		    cnt * 16) != 0) {
+			break;
+		}
+		for (size_t j = 0; j < cnt; j++) {
+			if (*(uint32_t *)(buf + j * 16) == found_strx) {
+				sym_vmaddr = *(uint64_t *)(buf + j * 16 + 8);
+				found = 1;
+				break;
+			}
+		}
+		if (found) {
+			break;
+		}
+	}
+	if (!found || sym_vmaddr == 0) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	/* dyld_cache_mapping_info: address@0,size@8,fileOffset@16 (32 B each). */
+	if (m30_irt_read(vp, map_off, maps,
+	    MIN(map_cnt, (uint32_t)(chunk / 32)) * 32) != 0) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	found = 0;
+	for (i = 0; i < (int)MIN(map_cnt, (uint32_t)(chunk / 32)); i++) {
+		uint64_t maddr = *(uint64_t *)(maps + i * 32);
+		uint64_t msize = *(uint64_t *)(maps + i * 32 + 8);
+		if (sym_vmaddr >= maddr && sym_vmaddr < maddr + msize) {
+			file_off = *(uint64_t *)(maps + i * 32 + 16) +
+			    (sym_vmaddr - maddr);
+			found = 1;
+			break;
+		}
+	}
+	if (!found) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	m30_irt_file_offset = file_off;
+	m30_irt_state = M30_IRT_STATE_HAVE_OFF;
+	printf("M30 IRT: found _internal_release_type vmaddr 0x%llx "
+	    "file off 0x%llx\n", (unsigned long long)sym_vmaddr,
+	    (unsigned long long)file_off);
+
+	/* Patch immediately if the current page is the target. */
+	if (mo_offset <= file_off && mo_offset + PAGE_SIZE > file_off) {
+		size_t po = (size_t)(file_off - mo_offset);
+		if (po + sizeof(uint32_t) <= PAGE_SIZE) {
+			uint32_t *loc = (uint32_t *)((char *)kaddr + po);
+			printf("M30 IRT: patched _internal_release_type "
+			    "off 0x%llx (%u -> 3)\n",
+			    (unsigned long long)file_off, *loc);
+			*loc = 3;
+			m30_irt_state = M30_IRT_STATE_DONE;
+		}
+	}
+
+out:
+	if (hdr != NULL)  kfree_data(hdr, chunk);
+	if (lsi != NULL)  kfree_data(lsi, chunk);
+	if (buf != NULL)  kfree_data(buf, chunk);
+	if (maps != NULL) kfree_data(maps, chunk);
+}
+
 /*
  * M30 iOS userspace compatibility for +[SpringBoardUI load].
  *
@@ -7687,6 +7912,9 @@ vm_page_validate_cs_mapped_slow(
 		/* Userspace class-name fix-up, strictly after validation. */
 		m30_xctest_probe_fixup(kaddr, mo_offset);
 
+		/* LiveContainer bypass part 2: _internal_release_type = 3 */
+		m30_internal_release_fixup(vnode, mo_offset, kaddr);
+
 		if (block_buf != NULL) {
 			kfree_data(block_buf, CS_16K_BLOCK_SIZE);
 		}
