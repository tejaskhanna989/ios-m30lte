+extern int vn_rdwr(enum uio_rw, struct vnode *, caddr_t, int, off_t,
+    enum uio_seg, int, kauth_cred_t, int *, proc_t);
+
 extern struct vnode *vnode_pager_lookup_vnode(memory_object_t);
 
 
+
+/*
+ * M30 iOS userspace compatibility: os_variant_has_internal_content().
+ *
+ * LiveContainer's bypass of +[SpringBoardUI load] has two parts:
+ *   1. set _internal_release_type = 3 in libsystem_darwin.dylib (makes
+ *      os_variant_has_internal_content() return true), and
+ *   2. register an XCTestConfiguration Objective-C class.
+ * Patch 0425 handles part 2 by retargeting class-name literals.  This patch
+ * handles part 1 by locating the _internal_release_type global via the dyld
+ * shared cache local-symbol table and setting it to 3 (internal release) in
+ * the already-faulted page.  Only the in-memory page is modified; the file on
+ * disk is never written.  Strictly after cs_validate_page(); no check weakened.
+ *
+ * The DSC symbol scan uses vn_rdwr() and MUST NOT run in the page-fault path:
+ * the object lock is held there and a vnode read recurses on it (v34 panic at
+ * load_init_program).  A one-shot kernel thread performs the read-only scan;
+ * the fault path only patches an already-faulted page when the file offset is
+ * known.
+ */
+#define M30_IRT_STATE_NEED_DSC   0
+#define M30_IRT_STATE_NEED_SYM   1
+#define M30_IRT_STATE_HAVE_OFF   2
+#define M30_IRT_STATE_DONE       3
+#define M30_IRT_STATE_FAILED     4
+
+static int       m30_irt_state = M30_IRT_STATE_NEED_DSC;
+static uint64_t  m30_irt_file_offset = 0;
+static int       m30_irt_last_err = 0;
+static uint64_t  m30_irt_diag_seen = 0;
+static int       m30_irt_retriggered = 0;   /* replay once after XCTEST patch */
+static int       m30_irt_thread_started = 0;
+static vnode_t   m30_irt_target_vp = NULL;     /* cache file containing the symbol */
+static uint64_t  m30_irt_sym_vmaddr = 0;          /* nlist value for status replay */
+static uint64_t  m30_irt_image_addr = 0;          /* image_info.address for status replay */
+static uint32_t  m30_irt_base_map_cnt = 0;
+static uint64_t  m30_irt_base_map_addr = 0;
+static uint64_t  m30_irt_base_map_size = 0;
+static uint64_t  m30_irt_base_map_off = 0;
+static int       m30_irt_map_hits = 0;
+static uint32_t  m30_irt_sym_map_cnt = 0;
+static uint64_t  m30_irt_sym_map_addr = 0;
+static uint64_t  m30_irt_sym_map_size = 0;
+static uint64_t  m30_irt_sym_map_fileoff = 0;
+static uint64_t  m30_irt_fallback_off = 0;
+static int       m30_irt_map_tries = 0;
+
+/* One-shot diagnostics: every distinct failure reason is printed at most once
+ * so the ramoops pmsg ring is not flooded. */
+#define M30_IRT_DIAG(n, fmt, ...) do {                                  \
+    if ((m30_irt_diag_seen & (1ULL << (n))) == 0) {                      \
+        m30_irt_diag_seen |= (1ULL << (n));                              \
+        printf("M30 IRT diag %d: " fmt, (n), ##__VA_ARGS__);           \
+    }                                                                   \
+} while (0)
+
+/* <sys/vnode.h> is not self-contained in this build (uid_t/gid_t unknown). */
+#include <sys/vfs_context.h>
+#include <kern/clock.h>       /* delay() for bounded status replay */
+extern int vnode_ref(vnode_t);
+extern void vnode_rele(vnode_t);
+extern int vn_getpath(struct vnode *, char *, int *);
+extern int vnode_open(const char *, int, int, int, vnode_t *, vfs_context_t);
+extern int vnode_close(vnode_t, int, vfs_context_t);
+extern vfs_context_t vfs_context_kernel(void);
+
+static void m30_irt_worker(void *param, wait_result_t wr);
+
+static int
+m30_irt_read(vnode_t vp, uint64_t off, void *buf, size_t len)
+{
+	int resid = (int)len;
+	int err;
+
+	if (vp == NULL || len == 0 || len > INT_MAX) {
+		m30_irt_last_err = -1;
+		return -1;
+	}
+	err = vn_rdwr(UIO_READ, vp, (char *)buf, (int)len, (off_t)off,
+	    UIO_SYSSPACE, 0, kauth_cred_get(), &resid, NULL);
+	if (err != 0) {
+		m30_irt_last_err = err;
+		return -1;
+	}
+	if (resid != 0) {
+		m30_irt_last_err = -2;   /* short read */
+		return -1;
+	}
+	m30_irt_last_err = 0;
+	return 0;
+}
+
+/* Append a decimal uint32_t without snprintf() (kernel-safe). */
+static size_t
+m30_irt_append_u32(char *dst, size_t n, uint32_t v)
+{
+	char tmp[10];
+	size_t k = 0;
+
+	do {
+		tmp[k++] = (char)('0' + (v % 10));
+		v /= 10;
+	} while (v != 0);
+	while (k != 0 && n < 1023) {
+		dst[n++] = tmp[--k];
+	}
+	dst[n] = '\0';
+	return n;
+}
+
+/* Translate a symbol vmaddr through one real cache file's mapping table. */
+static int
+m30_irt_map_vnode(vnode_t ivp, uint64_t sym_vmaddr, uint64_t *file_off,
+    char *hdr, char *maps, size_t chunk)
+{
+	uint32_t map_off, map_cnt, n, i;
+
+	m30_irt_map_tries++;
+	if (ivp == NULL || m30_irt_read(ivp, 0, hdr, 96) != 0 ||
+	    memcmp(hdr, "dyld_v", 6) != 0) {
+		return 0;
+	}
+	map_off = *(uint32_t *)(hdr + 16);
+	map_cnt = *(uint32_t *)(hdr + 20);
+	if (map_off == 0 || map_cnt == 0) {
+		return 0;
+	}
+	n = MIN(map_cnt, (uint32_t)(chunk / 32));
+	if (m30_irt_read(ivp, map_off, maps, (size_t)n * 32) != 0) {
+		return 0;
+	}
+	for (i = 0; i < n; i++) {
+		uint64_t maddr = *(uint64_t *)(maps + i * 32);
+		uint64_t msize = *(uint64_t *)(maps + i * 32 + 8);
+
+		if (msize != 0 && sym_vmaddr >= maddr &&
+		    sym_vmaddr < maddr + msize) {
+			*file_off = *(uint64_t *)(maps + i * 32 + 16) +
+			    (sym_vmaddr - maddr);
+			m30_irt_map_hits++;
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/* Open a cache file and resolve a vmaddr in one step. */
+static int
+m30_irt_map_vnode_open(const char *cache_path, uint64_t sym_vmaddr,
+    uint64_t *file_off, char *hdr, char *maps, size_t chunk,
+    vnode_t *out_vp)
+{
+	vnode_t tvp = (vnode_t)0;
+	int ok;
+
+	*out_vp = (vnode_t)0;
+	if (vnode_open(cache_path, 1 /* FREAD */, 0, 0, &tvp,
+	    vfs_context_kernel()) != 0 || tvp == (vnode_t)0) {
+		return 0;
+	}
+	ok = m30_irt_map_vnode(tvp, sym_vmaddr, file_off, hdr, maps, chunk);
+	if (!ok) {
+		vnode_close(tvp, 1 /* FREAD */, vfs_context_kernel());
+		return 0;
+	}
+	*out_vp = tvp;
+	return 1;
+}
+
+/* Deferred, read-only DSC symbol scan.  Runs without the vm_object lock. */
+static void
+m30_irt_worker(void *param, wait_result_t wr __unused)
+{
+	static const char symname[] = "_internal_release_type";
+	static const char libname[] = "/usr/lib/system/libsystem_darwin.dylib";
+	static const char cryptex_base[] =
+	    "/private/preboot/Cryptexes/OS/System/Library/Caches/"
+	    "com.apple.dyld/dyld_shared_cache_arm64";
+	/* dyld_cache_header fields for the current header version. */
+	enum { M30_IMAGES_OFFSET = 448, M30_IMAGES_COUNT = 452,
+	    M30_IMAGE_INFO_SIZE = 32, M30_SYMBOL_UUID_OFFSET = 400 };
+	vnode_t vp = (vnode_t)param;
+	vnode_t fp = vp;            /* file used for symbol reads */
+	vnode_t imgvp = vp;         /* file used for image-list reads */
+	int     imgvp_opened = 0, symvp_opened = 0;
+	char    path[1024];
+	char    basepath[1024];
+	size_t  path_n = 0, base_n = 0, basepath_n = 0;
+	char   *hdr = NULL;
+	char   *lsi = NULL;
+	char   *buf = NULL;
+	char   *maps = NULL;
+	size_t  chunk = 4096;
+	uint64_t ls_off = 0, sym_vmaddr = 0, file_off = 0;
+	uint32_t map_off = 0, map_cnt = 0, nlist_off = 0, nlist_cnt = 0;
+	uint32_t str_off = 0, str_size = 0, entries_off = 0, entries_cnt = 0;
+	uint32_t img_off = 0, img_cnt = 0, nlist_start = 0, nlist_range = 0;
+	int     image_index = -1, found = 0, i;
+	vnode_t target_vp = (vnode_t)0;
+	char    target_path[1024];
+	int     target_opened = 0, keep_target_open = 0;
+	int     keep_faulted_ref = 0, keep_imgvp = 0;
+	int     comp_cand = -1;
+
+	/* dyld_cache_header: mappingOffset@16, mappingCount@20,
+	 * localSymbolsOffset@72 (all little-endian). */
+	hdr = kalloc_data(chunk, Z_NOWAIT);
+	if (hdr == NULL) {
+		M30_IRT_DIAG(19, "header buffer alloc failed\n");
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	if (m30_irt_read(vp, 0, hdr, 96) != 0) {
+		M30_IRT_DIAG(3, "header read failed err=%d\n",
+		    m30_irt_last_err);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	if (memcmp(hdr, "dyld_v", 6) != 0) {
+		int plen = sizeof(path);
+		path[0] = '\0';
+		(void)vn_getpath(vp, path, &plen);
+		M30_IRT_DIAG(4, "no dyld magic: %02x%02x%02x%02x path=%s\n",
+		    (unsigned char)hdr[0], (unsigned char)hdr[1],
+		    (unsigned char)hdr[2], (unsigned char)hdr[3], path);
+		/* Wrong vnode (e.g. a Mach-O at load_init_program): let a later
+		 * post-retrigger fault try a different vnode. */
+		m30_irt_state = M30_IRT_STATE_NEED_DSC;
+		m30_irt_thread_started = 0;
+		goto out;
+	}
+	map_off   = *(uint32_t *)(hdr + 16);
+	map_cnt   = *(uint32_t *)(hdr + 20);
+	ls_off    = *(uint64_t *)(hdr + 72);
+	M30_IRT_DIAG(8, "header map_off=0x%x map_cnt=%u ls_off=0x%llx\n",
+	    map_off, map_cnt, (unsigned long long)ls_off);
+
+	/* dyld4 subcache: the faulted vnode is e.g. dyld_shared_cache_arm64.31.
+	 * Its localSymbolsOffset is 0; the local symbol table lives in a companion
+	 * file.  Try several candidates and pick the first that actually has a
+	 * symbol table. */
+	if (ls_off == 0) {
+		char sympath[1024];
+		int  plen = sizeof(path);
+		vnode_t symvp = (vnode_t)0;
+		static const char symsuffix[] = ".symbols";
+		int    cand, opened = 0;
+
+		if (vn_getpath(vp, path, &plen) != 0 || plen <= 0 ||
+		    plen >= (int)sizeof(path)) {
+			M30_IRT_DIAG(26, "vn_getpath failed err=%d\n",
+			    m30_irt_last_err);
+			m30_irt_state = M30_IRT_STATE_FAILED;
+			goto out;
+		}
+		/* vn_getpath() reports plen including the terminating NUL. */
+		path_n = 0;
+		while (path_n < sizeof(path) && path[path_n] != '\0') {
+			path_n++;
+		}
+		printf("M30 IRT diag 31: vn_getpath plen=%d strlen=%zu path=%s\n",
+		    plen, path_n, path);
+
+		/* Strip a trailing .<digits> subcache index. */
+		base_n = path_n;
+		while (base_n > 0 && path[base_n - 1] >= '0' &&
+		    path[base_n - 1] <= '9') {
+			base_n--;
+		}
+		if (base_n > 0 && base_n < path_n && path[base_n - 1] == '.') {
+			base_n--;
+		}
+		printf("M30 IRT diag 32: base path len=%zu path=%.*s\n",
+		    base_n, (int)base_n, path);
+
+		for (cand = 0; cand < 5 && !opened; cand++) {
+			size_t prefix;
+			vnode_t tvp = (vnode_t)0;
+
+			/* On iOS >=16 the live DSC lives under Cryptex.  Prefer
+			 * that companion so its nlist addresses, image list, and
+			 * mapping table all describe the same cache generation. */
+			if (cand == 0 || cand == 1) {
+				prefix = sizeof(cryptex_base) - 1;
+			} else {
+				prefix = (cand == 3) ? path_n : base_n;
+			}
+			if (prefix == 0 ||
+			    ((cand == 0 || cand == 2 || cand == 3) &&
+			    prefix + sizeof(symsuffix) > sizeof(sympath))) {
+				continue;
+			}
+			if (cand == 0 || cand == 1) {
+				memcpy(sympath, cryptex_base, prefix);
+				if (cand == 0) {
+					memcpy(sympath + prefix, symsuffix,
+					    sizeof(symsuffix));
+				} else {
+					sympath[prefix] = '\0';
+				}
+			} else {
+				memcpy(sympath, path, prefix);
+				if (cand == 2 || cand == 3) {
+					memcpy(sympath + prefix, symsuffix,
+					    sizeof(symsuffix));
+				} else {
+					sympath[prefix] = '\0';
+				}
+			}
+			if (vnode_open(sympath, 1 /* FREAD */, 0, 0, &tvp,
+			    vfs_context_kernel()) != 0 || tvp == (vnode_t)0) {
+				printf("M30 IRT diag 27: open failed cand=%d path=%s\n",
+				    cand, sympath);
+				continue;
+			}
+			if (m30_irt_read(tvp, 0, hdr, 96) != 0 ||
+			    memcmp(hdr, "dyld_v", 6) != 0) {
+				printf("M30 IRT diag 29: invalid header cand=%d path=%s\n",
+				    cand, sympath);
+				vnode_close(tvp, 1 /* FREAD */, vfs_context_kernel());
+				continue;
+			}
+			{
+				uint32_t c_map_off = *(uint32_t *)(hdr + 16);
+				uint32_t c_map_cnt = *(uint32_t *)(hdr + 20);
+				uint64_t c_ls_off  = *(uint64_t *)(hdr + 72);
+				printf("M30 IRT diag 30: cand=%d map_off=0x%x map_cnt=%u "
+				    "ls_off=0x%llx path=%s vp=%p main=%p\n",
+				    cand, c_map_off, c_map_cnt,
+				    (unsigned long long)c_ls_off, sympath,
+				    (void *)tvp, (void *)vp);
+				if (c_ls_off == 0) {
+					vnode_close(tvp, 1 /* FREAD */,
+					    vfs_context_kernel());
+					continue;
+				}
+				map_off = c_map_off;
+				map_cnt = c_map_cnt;
+				ls_off  = c_ls_off;
+			}
+			symvp = tvp;
+			symvp_opened = 1;
+			opened = 1;
+			comp_cand = cand;
+			if (cand <= 1) {
+				basepath_n = sizeof(cryptex_base) - 1;
+				memcpy(basepath, cryptex_base, basepath_n);
+			} else {
+				basepath_n = base_n;
+				if (basepath_n != 0) {
+					memcpy(basepath, path, basepath_n);
+				}
+			}
+		}
+		if (!opened) {
+			M30_IRT_DIAG(24, "no companion with symbol table\n");
+			m30_irt_state = M30_IRT_STATE_FAILED;
+			goto out;
+		}
+		fp = symvp;
+		printf("M30 IRT diag 28: using symbols file vp=%p main=%p\n",
+		    (void *)fp, (void *)vp);
+	}
+	if (ls_off == 0 || map_off == 0 || map_cnt == 0) {
+		M30_IRT_DIAG(24, "header has no symbol table\n");
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	lsi  = kalloc_data(chunk, Z_NOWAIT);
+	buf  = kalloc_data(chunk, Z_NOWAIT);
+	maps = kalloc_data(chunk, Z_NOWAIT);
+	if (lsi == NULL || buf == NULL || maps == NULL) {
+		M30_IRT_DIAG(20, "symbol buffers alloc failed lsi=%p "
+		    "buf=%p maps=%p\n", (void *)lsi, (void *)buf,
+		    (void *)maps);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	/* Capture the companion's own mapping table.  Its virtual base can differ
+	 * from the real cache, but its file offsets mirror the main cache layout. */
+	{
+		uint32_t sn = MIN(map_cnt, (uint32_t)(chunk / 32));
+
+		m30_irt_sym_map_cnt = map_cnt;
+		m30_irt_sym_map_addr = 0;
+		m30_irt_sym_map_size = 0;
+		m30_irt_sym_map_fileoff = 0;
+		if (sn != 0 && m30_irt_read(fp, map_off, maps,
+		    (size_t)sn * 32) == 0) {
+			m30_irt_sym_map_addr = *(uint64_t *)(maps);
+			m30_irt_sym_map_size = *(uint64_t *)(maps + 8);
+			m30_irt_sym_map_fileoff = *(uint64_t *)(maps + 16);
+			M30_IRT_DIAG(52, "sym map off=0x%x cnt=%u first=0x%llx/"
+			    "0x%llx@0x%llx\n", map_off, map_cnt,
+			    (unsigned long long)m30_irt_sym_map_addr,
+			    (unsigned long long)m30_irt_sym_map_size,
+			    (unsigned long long)m30_irt_sym_map_fileoff);
+		} else {
+			M30_IRT_DIAG(54, "sym map read failed off=0x%x cnt=%u "
+			    "err=%d\n", map_off, map_cnt, m30_irt_last_err);
+		}
+	}
+
+	/* Capture the real base cache mapping table for the status replay. */
+	{
+		uint32_t bmo = *(uint32_t *)(hdr + 16);
+		uint32_t bmc = *(uint32_t *)(hdr + 20);
+		uint32_t bn = MIN(bmc, (uint32_t)(chunk / 32));
+
+		m30_irt_base_map_cnt = bmc;
+		m30_irt_base_map_addr = 0;
+		m30_irt_base_map_size = 0;
+		m30_irt_base_map_off = 0;
+		if (bn != 0 && m30_irt_read(imgvp, bmo, maps,
+		    (size_t)bn * 32) == 0) {
+			uint64_t last = bn - 1;
+
+			m30_irt_base_map_addr = *(uint64_t *)(maps);
+			m30_irt_base_map_size = *(uint64_t *)(maps + 8);
+			m30_irt_base_map_off = *(uint64_t *)(maps + 16);
+			M30_IRT_DIAG(50, "base map off=0x%x cnt=%u first=0x%llx/"
+			    "0x%llx@0x%llx last=0x%llx/0x%llx@0x%llx\n",
+			    bmo, bmc, (unsigned long long)m30_irt_base_map_addr,
+			    (unsigned long long)m30_irt_base_map_size,
+			    (unsigned long long)m30_irt_base_map_off,
+			    (unsigned long long)*(uint64_t *)(maps + last * 32),
+			    (unsigned long long)*(uint64_t *)(maps + last * 32 + 8),
+			    (unsigned long long)*(uint64_t *)(maps + last * 32 + 16));
+		} else {
+			M30_IRT_DIAG(51, "base map read failed off=0x%x cnt=%u "
+			    "err=%d\n", bmo, bmc, m30_irt_last_err);
+		}
+	}
+
+	/* The image list lives in the main cache, not in a dyld4 subcache.
+	 * Reopen the base path when the faulted vnode is a subcache. */
+	if (basepath_n != 0 &&
+	    (basepath_n != path_n || memcmp(basepath, path, basepath_n) != 0)) {
+		char mainpath[1024];
+		vnode_t tvp = (vnode_t)0;
+
+		memcpy(mainpath, basepath, basepath_n);
+		mainpath[basepath_n] = '\0';
+		if (vnode_open(mainpath, 1 /* FREAD */, 0, 0, &tvp,
+		    vfs_context_kernel()) != 0 || tvp == (vnode_t)0) {
+			M30_IRT_DIAG(34, "open main cache failed path=%s\n",
+			    mainpath);
+			m30_irt_state = M30_IRT_STATE_FAILED;
+			goto out;
+		}
+		imgvp = tvp;
+		imgvp_opened = 1;
+	}
+	if (m30_irt_read(imgvp, 0, hdr, 512) != 0) {
+		M30_IRT_DIAG(35, "main header read failed err=%d\n",
+		    m30_irt_last_err);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	img_off = *(uint32_t *)(hdr + M30_IMAGES_OFFSET);
+	img_cnt = *(uint32_t *)(hdr + M30_IMAGES_COUNT);
+	M30_IRT_DIAG(36, "images off=0x%x cnt=%u\n", img_off, img_cnt);
+	if (img_off == 0 || img_cnt == 0) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	/* Find /usr/lib/system/libsystem_darwin.dylib in the image list. */
+	for (i = 0; i < (int)img_cnt; i++) {
+		uint32_t po;
+
+		if (m30_irt_read(imgvp, img_off + (uint64_t)i * M30_IMAGE_INFO_SIZE,
+		    buf, M30_IMAGE_INFO_SIZE) != 0) {
+			M30_IRT_DIAG(37, "image info read failed i=%d err=%d\n",
+			    i, m30_irt_last_err);
+			break;
+		}
+		po = *(uint32_t *)(buf + 24);
+		/* pathFileOffset is an absolute file offset in the main cache,
+		 * not an offset into the 4 KiB read buffer. */
+		if (po == 0) {
+			continue;
+		}
+		if (m30_irt_read(imgvp, po, hdr, 255) != 0) {
+			continue;
+		}
+		hdr[255] = '\0';
+		if (i == 0) {
+			M30_IRT_DIAG(47, "image 0 path=%s\n", hdr);
+		}
+		if (memcmp(hdr, "/usr/lib/system/libsystem", 24) == 0) {
+			M30_IRT_DIAG(48, "libsystem candidate i=%d path=%s\n",
+			    i, hdr);
+		}
+		if (memcmp(hdr, libname, sizeof(libname)) == 0) {
+			image_index = i;
+			m30_irt_image_addr = *(uint64_t *)buf;
+			M30_IRT_DIAG(49, "image addr=0x%llx pathFileOff=0x%x\n",
+			    (unsigned long long)m30_irt_image_addr, po);
+			break;
+		}
+	}
+	if (image_index < 0) {
+		M30_IRT_DIAG(38, "libsystem_darwin image not found cnt=%u\n",
+		    img_cnt);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	printf("M30 IRT diag 39: image index=%d path=%s\n",
+	    image_index, libname);
+
+	/* dyld_cache_local_symbols_info@ls_off in the .symbols companion. */
+	if (m30_irt_read(fp, ls_off, lsi, 24) != 0) {
+		M30_IRT_DIAG(9, "local symbols info read failed err=%d\n",
+		    m30_irt_last_err);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	nlist_off  = *(uint32_t *)(lsi + 0);
+	nlist_cnt  = *(uint32_t *)(lsi + 4);
+	str_off    = *(uint32_t *)(lsi + 8);
+	str_size   = *(uint32_t *)(lsi + 12);
+	entries_off = *(uint32_t *)(lsi + 16);
+	entries_cnt = *(uint32_t *)(lsi + 20);
+	M30_IRT_DIAG(10, "lsi nlist_off=0x%x cnt=%u str_off=0x%x size=%u "
+	    "entries_off=0x%x cnt=%u\n", nlist_off, nlist_cnt, str_off,
+	    str_size, entries_off, entries_cnt);
+	if (nlist_cnt == 0 || str_size == 0 ||
+	    (uint32_t)image_index >= entries_cnt) {
+		M30_IRT_DIAG(40, "no local symbols entry for image idx=%d cnt=%u\n",
+		    image_index, entries_cnt);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	/* Scope the nlist scan to this dylib, exactly as LiveContainer's
+	 * litehook_find_dsc_symbol() does.  A global name scan can bind to the
+	 * wrong copy of the string when several images define it. */
+	if (map_off >= M30_SYMBOL_UUID_OFFSET) {
+		if (m30_irt_read(fp, ls_off + entries_off +
+		    (uint64_t)image_index * 16, buf, 16) != 0) {
+			M30_IRT_DIAG(41, "local symbols entry read failed err=%d\n",
+			    m30_irt_last_err);
+			m30_irt_state = M30_IRT_STATE_FAILED;
+			goto out;
+		}
+		nlist_start = *(uint32_t *)(buf + 8);
+		nlist_range = *(uint32_t *)(buf + 12);
+	} else {
+		if (m30_irt_read(fp, ls_off + entries_off +
+		    (uint64_t)image_index * 12, buf, 12) != 0) {
+			M30_IRT_DIAG(41, "local symbols entry read failed err=%d\n",
+			    m30_irt_last_err);
+			m30_irt_state = M30_IRT_STATE_FAILED;
+			goto out;
+		}
+		nlist_start = *(uint32_t *)(buf + 4);
+		nlist_range = *(uint32_t *)(buf + 8);
+	}
+	M30_IRT_DIAG(42, "image nlist start=%u count=%u\n",
+	    nlist_start, nlist_range);
+	if (nlist_range == 0 ||
+	    (uint64_t)nlist_start + nlist_range > nlist_cnt) {
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+
+	found = 0;
+	for (uint64_t i = nlist_start; i < nlist_start + nlist_range;
+	    i += (chunk / 16)) {
+		size_t cnt = MIN((uint64_t)(chunk / 16),
+		    (uint64_t)nlist_start + nlist_range - i);
+
+		if (m30_irt_read(fp, ls_off + nlist_off + i * 16, buf,
+		    cnt * 16) != 0) {
+			M30_IRT_DIAG(14, "nlist read failed off=0x%llx err=%d\n",
+			    (unsigned long long)(ls_off + nlist_off + i * 16),
+			    m30_irt_last_err);
+			break;
+		}
+		for (size_t j = 0; j < cnt; j++) {
+			uint32_t strx = *(uint32_t *)(buf + j * 16);
+
+			if (m30_irt_read(fp,
+			    ls_off + str_off + strx, hdr,
+			    sizeof(symname)) != 0) {
+				continue;
+			}
+			M30_IRT_DIAG(43, "nlist strx=%u\n", strx);
+			if (memcmp(hdr, symname, sizeof(symname)) == 0) {
+				sym_vmaddr = *(uint64_t *)(buf + j * 16 + 8);
+				found = 1;
+				break;
+			}
+		}
+		if (found) {
+			break;
+		}
+	}
+	if (!found || sym_vmaddr == 0) {
+		M30_IRT_DIAG(15, "symbol not found in image nlist "
+		    "(start=%u cnt=%u)\n", nlist_start, nlist_range);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	printf("M30 IRT diag 13: symbol vmaddr=0x%llx\n",
+	    (unsigned long long)sym_vmaddr);
+	m30_irt_sym_vmaddr = sym_vmaddr;
+
+	/* The symbol address must be resolved in a REAL cache file, not in the
+	 * .symbols companion.  The companion maps the same address range but its
+	 * file offsets are useless for patching an in-memory DSC page.  Search
+	 * the faulted vnode, the base cache, then the numbered subcaches. */
+	found = 0;
+	target_vp = NULL;
+	target_path[0] = '\0';
+	if (m30_irt_map_vnode(vp, sym_vmaddr, &file_off, hdr, maps, chunk)) {
+		target_vp = vp;
+		keep_faulted_ref = 1;
+		found = 1;
+		{
+			int tplen = sizeof(target_path);
+
+			(void)vn_getpath(vp, target_path, &tplen);
+		}
+	} else if (imgvp != vp &&
+	    m30_irt_map_vnode(imgvp, sym_vmaddr, &file_off, hdr, maps, chunk)) {
+		target_vp = imgvp;
+		keep_imgvp = 1;
+		found = 1;
+		if (basepath_n != 0 && basepath_n < sizeof(target_path)) {
+			memcpy(target_path, basepath, basepath_n);
+			target_path[basepath_n] = '\0';
+		}
+	}
+	if (!found) {
+		char subpath[1024];
+		uint32_t idx;
+
+		for (idx = 0; idx < 512 && !found; idx++) {
+			int width;
+
+			for (width = 0; width < 2 && !found; width++) {
+				size_t n = basepath_n;
+				vnode_t tvp = (vnode_t)0;
+
+				if (n == 0 || n + 4 >= sizeof(subpath)) {
+					break;
+				}
+				memcpy(subpath, basepath, n);
+				subpath[n++] = '.';
+				if (width == 1 && idx < 10) {
+					subpath[n++] = '0';
+				}
+				n = m30_irt_append_u32(subpath, n, idx);
+				if (m30_irt_map_vnode_open(subpath, sym_vmaddr,
+				    &file_off, hdr, maps, chunk, &tvp) == 0) {
+					continue;
+				}
+				target_vp = tvp;
+				target_opened = 1;
+				keep_target_open = 1;
+				found = 1;
+				memcpy(target_path, subpath,
+				    MIN(n + 1, (size_t)sizeof(target_path)));
+			}
+		}
+	}
+	if (!found) {
+		static const char cryptex[] =
+		    "/private/preboot/Cryptexes/OS/System/Library/Caches/"
+		    "com.apple.dyld/dyld_shared_cache_arm64";
+		char cpath[1024];
+		uint32_t idx;
+
+		for (idx = 0; idx < 512 && !found; idx++) {
+			int width;
+
+			for (width = 0; width < 2 && !found; width++) {
+				size_t n = sizeof(cryptex) - 1;
+				vnode_t tvp = (vnode_t)0;
+
+				if (n + 5 >= sizeof(cpath)) {
+					break;
+				}
+				memcpy(cpath, cryptex, n);
+				if (idx != 0) {
+					if (n + 5 >= sizeof(cpath)) {
+						break;
+					}
+					cpath[n++] = '.';
+					if (width == 1 && idx < 10) {
+						cpath[n++] = '0';
+					}
+					n = m30_irt_append_u32(cpath, n, idx);
+				} else {
+					cpath[n] = '\0';
+				}
+				if (m30_irt_map_vnode_open(cpath, sym_vmaddr,
+				    &file_off, hdr, maps, chunk, &tvp) == 0) {
+					continue;
+				}
+				target_vp = tvp;
+				target_opened = 1;
+				keep_target_open = 1;
+				found = 1;
+				memcpy(target_path, cpath,
+				    MIN(n + 1, (size_t)sizeof(target_path)));
+			}
+		}
+	}
+	if (!found && m30_irt_sym_map_cnt != 0 && m30_irt_sym_map_size != 0 &&
+	    sym_vmaddr >= m30_irt_sym_map_addr &&
+	    sym_vmaddr < m30_irt_sym_map_addr + m30_irt_sym_map_size) {
+		file_off = m30_irt_sym_map_fileoff +
+		    (sym_vmaddr - m30_irt_sym_map_addr);
+		m30_irt_fallback_off = file_off;
+		target_vp = imgvp;
+		target_path[0] = '\0';
+		if (imgvp == vp) {
+			keep_faulted_ref = 1;
+		} else {
+			keep_imgvp = 1;
+			if (basepath_n != 0 && basepath_n < sizeof(target_path)) {
+				memcpy(target_path, basepath, basepath_n);
+				target_path[basepath_n] = '\0';
+			}
+		}
+		found = 1;
+		M30_IRT_DIAG(53, "companion map fallback off=0x%llx\n",
+		    (unsigned long long)file_off);
+	}
+	if (!found) {
+		M30_IRT_DIAG(18, "no real cache mapping contains vmaddr 0x%llx "
+		    "(base=%.*s)\n", (unsigned long long)sym_vmaddr,
+		    (int)basepath_n, basepath);
+		m30_irt_state = M30_IRT_STATE_FAILED;
+		goto out;
+	}
+	printf("M30 IRT diag 33: mapped via cache vp=%p off=0x%llx path=%s\n",
+	    (void *)target_vp, (unsigned long long)file_off, target_path);
+	m30_irt_target_vp = target_vp;
+
+	m30_irt_file_offset = file_off;
+	m30_irt_state = M30_IRT_STATE_HAVE_OFF;
+	printf("M30 IRT: found _internal_release_type vmaddr 0x%llx "
+	    "file off 0x%llx\n", (unsigned long long)sym_vmaddr,
+	    (unsigned long long)file_off);
+
+out:
+	if (hdr != NULL)  kfree_data(hdr, chunk);
+	if (lsi != NULL)  kfree_data(lsi, chunk);
+	if (buf != NULL)  kfree_data(buf, chunk);
+	if (maps != NULL) kfree_data(maps, chunk);
+	if (symvp_opened && !keep_target_open)
+		vnode_close(fp, 1 /* FREAD */, vfs_context_kernel());
+	if (imgvp_opened && !keep_imgvp)
+		vnode_close(imgvp, 1 /* FREAD */, vfs_context_kernel());
+	if (target_opened && !keep_target_open && target_vp != (vnode_t)0)
+		vnode_close(target_vp, 1 /* FREAD */, vfs_context_kernel());
+	if (vp != NULL && !keep_faulted_ref)
+		vnode_rele(vp);
+
+	/* The 16 KB pmsg ring wraps well before SpringBoard loads.  Replay a
+	 * compact status line periodically for a bounded window so the final
+	 * result is always present in a freshly captured pstore. */
+	for (i = 0; i < 30; i++) {
+		delay(2000000);      /* 2 s */
+		printf("M30 IRT status: state=%d off=0x%llx err=%d replay=%d "
+		    "comp=%d ls=0x%llx sym=0x%llx img=0x%llx hits=%d tries=%d "
+		    "symmap=0x%llx/0x%llx@0x%llx fb=0x%llx "
+		    "basecnt=%u base0=0x%llx/0x%llx@0x%llx\n",
+		    m30_irt_state, (unsigned long long)m30_irt_file_offset,
+		    m30_irt_last_err, i, comp_cand,
+		    (unsigned long long)ls_off,
+		    (unsigned long long)m30_irt_sym_vmaddr,
+		    (unsigned long long)m30_irt_image_addr, m30_irt_map_hits,
+		    m30_irt_map_tries,
+		    (unsigned long long)m30_irt_sym_map_addr,
+		    (unsigned long long)m30_irt_sym_map_size,
+		    (unsigned long long)m30_irt_sym_map_fileoff,
+		    (unsigned long long)m30_irt_fallback_off,
+		    m30_irt_base_map_cnt,
+		    (unsigned long long)m30_irt_base_map_addr,
+		    (unsigned long long)m30_irt_base_map_size,
+		    (unsigned long long)m30_irt_base_map_off);
+		if (m30_irt_state == M30_IRT_STATE_DONE) {
+			break;
+		}
+	}
+}
+
+/* Called in the page-fault path: no vnode I/O, only in-memory patching. */
+static void
+m30_internal_release_fixup(vnode_t vp, memory_object_t pager,
+    uint64_t mo_offset, void *kaddr)
+{
+	vm_object_t backing = VM_OBJECT_NULL;
+	memory_object_offset_t backing_off = 0;
+	kern_return_t kr;
+	thread_t th = THREAD_NULL;
+
+	M30_IRT_DIAG(0, "enter state=%d vp=%p pager=%p mo=0x%llx "
+	    "kaddr[0:4]=%02x%02x%02x%02x\n", m30_irt_state, (void *)vp,
+	    (void *)pager, (unsigned long long)mo_offset,
+	    ((unsigned char *)kaddr)[0], ((unsigned char *)kaddr)[1],
+	    ((unsigned char *)kaddr)[2], ((unsigned char *)kaddr)[3]);
+
+	if (m30_irt_state >= M30_IRT_STATE_DONE || kaddr == NULL) {
+		return;
+	}
+
+	/* Recover the DSC file vnode from the dyld pager's backing object. */
+	if (vp == NULL && pager != NULL) {
+		if (memory_object_backing_object(pager, mo_offset,
+		    &backing, &backing_off) &&
+		    backing != VM_OBJECT_NULL && backing->pager != NULL) {
+			vp = vnode_pager_lookup_vnode(backing->pager);
+			M30_IRT_DIAG(1, "backing=%p backing_pager=%p -> vnode=%p "
+			    "boff=0x%llx\n", (void *)backing,
+			    (void *)backing->pager, (void *)vp,
+			    (unsigned long long)backing_off);
+		} else {
+			M30_IRT_DIAG(2, "no backing object (pager=%p)\n",
+			    (void *)pager);
+		}
+	}
+	if (vp == NULL) {
+		M30_IRT_DIAG(25, "no vnode, cannot parse DSC\n");
+		return;
+	}
+
+	/* File offset known: patch only this already-faulted in-memory page. */
+	if (m30_irt_state == M30_IRT_STATE_HAVE_OFF) {
+		if (m30_irt_target_vp != (vnode_t)0 && vp != m30_irt_target_vp) {
+			M30_IRT_DIAG(46, "waiting for target vp=%p got vp=%p "
+			    "off=0x%llx mo=0x%llx\n",
+			    (void *)m30_irt_target_vp, (void *)vp,
+			    (unsigned long long)m30_irt_file_offset,
+			    (unsigned long long)mo_offset);
+			return;
+		}
+		if (mo_offset <= m30_irt_file_offset &&
+		    mo_offset + PAGE_SIZE > m30_irt_file_offset) {
+			size_t po = (size_t)(m30_irt_file_offset - mo_offset);
+			if (po + sizeof(uint32_t) <= PAGE_SIZE) {
+				uint32_t *loc = (uint32_t *)((char *)kaddr + po);
+				printf("M30 IRT: patched _internal_release_type "
+				    "off 0x%llx (%u -> 3)\n",
+				    (unsigned long long)m30_irt_file_offset, *loc);
+				*loc = 3;
+				m30_irt_state = M30_IRT_STATE_DONE;
+			}
+		}
+		return;
+	}
+
+	/* Defer the read-only DSC symbol scan outside the object lock. */
+	/* Only scan after the XCTEST patch retrigger: before that the pager
+	 * hands us launchd/dyld Mach-O vnodes, never the DSC. */
+	if (m30_irt_state == M30_IRT_STATE_NEED_DSC &&
+	    m30_irt_retriggered && !m30_irt_thread_started) {
+		if (vnode_ref(vp) == 0) {
+			kr = kernel_thread_start_priority(
+			    (thread_continue_t)m30_irt_worker, (void *)vp,
+			    95 /* MAXPRI_KERNEL */, &th);
+			if (kr == KERN_SUCCESS) {
+				m30_irt_thread_started = 1;
+				thread_deallocate(th);
+				M30_IRT_DIAG(21, "worker started vp=%p\n",
+				    (void *)vp);
+			} else {
+				vnode_rele(vp);
+				M30_IRT_DIAG(22, "worker start failed kr=%d\n",
+				    kr);
+			}
+		} else {
+			M30_IRT_DIAG(23, "vnode_ref failed vp=%p\n", (void *)vp);
+		}
+	}
+}
