diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -708,6 +708,9 @@
 }
 
 static uint64_t sweet_fb_logged;        /* selectors already logged (< 64) */
+#if defined(ARM64_BOARD_CONFIG_M30LTE)
+static uint8_t sweet_fb_abi_trace_count[128]; /* bounded per-selector trace */
+#endif
 
 IOReturn
 IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
@@ -825,6 +828,32 @@
 		break;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_M30LTE)
+	/* v68 diagnostic only.  Genuine iOS 16.7 IOMobileFramebuffer disassembles
+	 * selector 79 as a chunked block read (block ID + byte offset), so the
+	 * block IDs and scalar inputs must be observed before any response is
+	 * synthesized.  This changes no return value or output byte. */
+	{
+		uint32_t sel = selector;
+		bool trace = sel == 79 || sel == 74 || sel == 84 ||
+		    sel == 50 || sel == 68 || sel == 55;
+		if (trace && sweet_fb_abi_trace_count[sel] < 4) {
+			sweet_fb_abi_trace_count[sel]++;
+			char name[32];
+			char line[192];
+			proc_selfname(name, sizeof(name));
+			snprintf(line, sizeof(line),
+			    "M30 FB: ABI sel=%u name=%s in=%u/%u s0=0x%llx s1=0x%llx s2=0x%llx s3=0x%llx out=%u/%u",
+			    sel, name, args->scalarInputCount, args->structureInputSize,
+			    (unsigned long long)(args->scalarInputCount > 0 ? args->scalarInput[0] : 0),
+			    (unsigned long long)(args->scalarInputCount > 1 ? args->scalarInput[1] : 0),
+			    (unsigned long long)(args->scalarInputCount > 2 ? args->scalarInput[2] : 0),
+			    (unsigned long long)(args->scalarInputCount > 3 ? args->scalarInput[3] : 0),
+			    args->scalarOutputCount, args->structureOutputSize);
+			m30_pmsg_diag_line(line);
+		}
+	}
+#endif
 	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
 		args->scalarOutput[i] = i < outCount ? out[i] : 0;
 	}
