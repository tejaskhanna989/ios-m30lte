+/* Diagnostic snapshot used by the proven framebuffer heartbeat path. */
+void m30_ui_snapshot(int *sb, int *bb, int *irt, const char **reason)
+{
+	sweet_ui_sb_pid = 0;
+	sweet_ui_bb_pid = 0;
+	proc_iterate(PROC_ALLPROCLIST, sweet_ui_proc, NULL, NULL, NULL);
+	*sb = sweet_ui_sb_pid;
+	*bb = sweet_ui_bb_pid;
+	*irt = m30_irt_state_snapshot();
+	*reason = m30_last_crash_reason[0] != '\0' ? m30_last_crash_reason : "none";
+}
+
