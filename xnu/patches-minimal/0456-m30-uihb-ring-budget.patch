 extern int  m30_ls_diag_enabled;     /* bsd/dev/sweet_sample.c */
 extern void m30_ls_diag_line(const char *line); /* bsd/dev/sweet_sample.c */
+/*
+ * v85 diagnostic volume control.
+ *
+ * The pmsg ring is 16384 bytes and holds roughly 100 records. Measured from our
+ * own captures (v74, v79) one sample of SpringBoard plus backboardd is 29-58
+ * lines of 101-253 bytes, i.e. a quarter to a half of the ring per sample, so a
+ * few samples evict everything older - including the framebuffer records that
+ * are the actual lock-screen evidence.
+ *
+ * Everything this file emits for a sample passes through m30_smp_emit(), which
+ * enforces a hard TOTAL byte budget: headers, per-thread lines and truncation
+ * all count. Space for the truncation marker is reserved up front, so the
+ * marker itself always fits and the budget can never be exceeded. A line that
+ * would cross the boundary is emitted truncated and suffixed "..." rather than
+ * dropped, so a short line is never mistaken for a complete one.
+ *
+ * Read-only: no state change, no injection, no timing change beyond skipping
+ * further output.
+ */
+#define M30_SMP_MARKER	"M30 SMP budget reached, output truncated"
+#define M30_SMP_DEFAULT_KIB	2
+
+static int
+m30_smp_budget_kib(void)
+{
+	static int kib = -1;
+	if (kib < 0) {
+		int v = M30_SMP_DEFAULT_KIB;
+		(void)PE_parse_boot_argn("m30samplebudget", &v, sizeof(v));
+		kib = (v < 1) ? 1 : v;
+	}
+	return kib;
+}
+
+static void
+m30_smp_emit(const char *line)
+{
+	static int used;
+	static bool capped;
+	const int reserve = (int)strlen(M30_SMP_MARKER) + 1; /* text + newline */
+	const int budget = m30_smp_budget_kib() * 1024;
+	char buf[256];
+	int len, room;
+
+	if (capped) {
+		return;
+	}
+	/* Keep the marker's space free at all times. */
+	room = budget - reserve - used;
+	if (room <= 0) {
+		if (m30_ls_diag_enabled) {
+			m30_ls_diag_line(M30_SMP_MARKER);
+		} else {
+			printf("%s\n", M30_SMP_MARKER);
+		}
+		used += reserve;
+		capped = true;
+		return;
+	}
+
+	len = (int)strlen(line);
+	/*
+	 * Clip to the local buffer first. Lines are capped at 400 bytes by the
+	 * caller, so this is a guard, not the normal path; when it does fire the
+	 * "..." below marks the cut so a clipped line is never read as complete.
+	 */
+	if (len > (int)sizeof(buf) - 1) {
+		len = (int)sizeof(buf) - 1;
+	}
+	memcpy(buf, line, (size_t)len);
+	buf[len] = '\0';
+
+	if (len + 1 > room) {
+		/*
+		 * Truncate to fit. `room` is the number of bytes available
+		 * INCLUDING the trailing newline, so the text is clamped to
+		 * room - 1; using room here would emit one byte more than it
+		 * charges and the total would exceed the budget by one byte per
+		 * truncation. Three dots mark the cut.
+		 */
+		len = room - 1;
+		if (len >= 3) {
+			buf[len - 3] = '.';
+			buf[len - 2] = '.';
+			buf[len - 1] = '.';
+		}
+		buf[len] = '\0';
+	}
+
+	if (m30_ls_diag_enabled) {
+		m30_ls_diag_line(buf);
+	} else {
+		printf("%s\n", buf);
+	}
+	used += len + 1;
+}
