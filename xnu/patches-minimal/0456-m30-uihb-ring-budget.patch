diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index 5be9ce8..8d412db 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -106,7 +106,24 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	static int chan;
 	if (!PE_parse_boot_argn("sweetsample", sweet_sample_names, sizeof(sweet_sample_names))) {
-		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
+		/*
+		 * v85: was "SpringBoard,backboardd", i.e. ON BY DEFAULT.
+		 *
+		 * No accepted candidate has ever carried a sweetsample boot-arg
+		 * (tools/test_m30_native_bootargs.py asserts its absence from the
+		 * pinned v68 cmdline), so this default has run on EVERY boot,
+		 * including the accepted baseline - while the ring it writes into
+		 * is only 16384 bytes. Measured on v79
+		 * (validation/physical-boot-test/20261127-v79-pstore): 57 sampler
+		 * lines = 8190 bytes = 50% of the ring, and ZERO SWEET SURF records
+		 * survived the wrap. The diagnostic was evicting the very evidence
+		 * it exists to protect.
+		 *
+		 * Dormant by default. Pass sweetsample=SpringBoard (or a comma list)
+		 * to enable. The 0455 lock-screen diagnostic sets the names itself
+		 * and is unaffected.
+		 */
+		strlcpy(sweet_sample_names, "-", sizeof(sweet_sample_names));
 	}
 	if (sweet_sample_names[0] == '-') {
 		return;
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index b7043ff..c74a5d5 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1053,9 +1053,43 @@ sweet_sample_task(const char *name, int pid, task_t task)
 		slide = sr->sr_slide;
 		vm_shared_region_deallocate(sr);
 	}
+	/*
+	 * v85 diagnostic-volume budget.
+	 *
+	 * The pmsg ring these lines are written to is 16384 bytes and holds about
+	 * 100 records. Measured from our own captures: one sample of SpringBoard
+	 * plus backboardd is 29-58 lines of 101-253 bytes (v74 and v79 pstore
+	 * decodes under validation/physical-boot-test/). A sample therefore
+	 * consumes a quarter to a half of the ring, so three or four samples
+	 * evict everything older, including the framebuffer and SWEET SURF
+	 * records that are the actual lock-screen evidence.
+	 *
+	 * In v74 only ONE sample ran and the framebuffer still shrank to 4
+	 * records, because the rest of the ring was spent on AKS access logging
+	 * (46 lines in that capture). Bounding the sampler alone is therefore
+	 * not sufficient; sampler output is bounded here so it stops being the
+	 * largest single evictor, and the remaining work is to stop the sampler
+	 * from being enabled by default at all (it currently is, via 0054).
+	 *
+	 * m30samplebudget (KiB, default 2) caps total sampler output per boot so
+	 * at least ~12 KiB of the ring is left for other evidence. On exhaustion
+	 * exactly one marker line is emitted, so a wrapped ring can never be
+	 * mistaken for a silent sampler. Read-only: no state, no injection, no
+	 * timing change beyond skipping further output.
+	 */
+	static int m30_sample_bytes;
+	static bool m30_sample_capped;
+	int m30_sample_budget_kib = 2;
+	(void)PE_parse_boot_argn("m30samplebudget", &m30_sample_budget_kib,
+	    sizeof(m30_sample_budget_kib));
+	if (m30_sample_budget_kib < 1) {
+		m30_sample_budget_kib = 1;
+	}
 	char hdr[192];
-	snprintf(hdr, sizeof(hdr), "SMP %s[%d] slide 0x%llx mh 0x%llx", name, pid, slide, task->mach_header_vm_address);
+	snprintf(hdr, sizeof(hdr), "SMP %s[%d] slide 0x%llx mh 0x%llx budget %d KiB",
+	    name, pid, slide, task->mach_header_vm_address, m30_sample_budget_kib);
 	if (m30_ls_diag_enabled) m30_ls_diag_line(hdr); else printf("%s\n", hdr);
+	m30_sample_bytes += (int)strlen(hdr) + 1;
 
 	task_lock(task);
 	queue_iterate(&task->threads, thread, thread_t, task_threads) {
@@ -1081,7 +1115,21 @@ sweet_sample_task(const char *name, int pid, task_t task)
 			}
 			fp = frame[0];
 		}
+		if (m30_sample_capped) {
+			continue;
+		}
+		if (m30_sample_bytes > m30_sample_budget_kib * 1024) {
+			/* One marker, so a wrapped ring is never read as a silent sampler. */
+			if (m30_ls_diag_enabled) {
+				m30_ls_diag_line("M30 SMP budget reached, further samples suppressed");
+			} else {
+				printf("M30 SMP budget reached, further samples suppressed\n");
+			}
+			m30_sample_capped = true;
+			continue;
+		}
 		if (m30_ls_diag_enabled) m30_ls_diag_line(line); else printf("%s\n", line);
+		m30_sample_bytes += (int)strlen(line) + 1;
 	}
 	task_unlock(task);
 }
