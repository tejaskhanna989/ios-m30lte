diff --git a/osfmk/vm/vm_fault.c b/osfmk/vm/vm_fault.c
--- a/osfmk/vm/vm_fault.c
+++ b/osfmk/vm/vm_fault.c
@@ -95,6 +95,11 @@
 #include <vm/vm_kern.h>
 #include <vm/pmap.h>
 #include <vm/vm_pageout.h>
+
+/* Code-directory block size for 16K page hashes on 4K kernels. */
+#define CS_16K_BLOCK_SHIFT  14
+#define CS_16K_BLOCK_SIZE   (1U << CS_16K_BLOCK_SHIFT)
+#define CS_16K_BLOCK_MASK   (CS_16K_BLOCK_SIZE - 1)
 #include <vm/vm_protos.h>
 #include <vm/vm_external.h>
 #include <vm/memory_object.h>
@@ -7543,17 +7548,70 @@
 	vnode = vnode_pager_lookup_vnode(pager);
 	mo_offset = page->vmp_offset + object->paging_offset;
 
-	/* verify the SHA1 hash for this page */
-	validated = 0;
-	tainted = 0;
-	nx = 0;
-	cs_validate_page(vnode,
-	    pager,
-	    mo_offset,
-	    (const void *)((const char *)kaddr),
-	    &validated,
-	    &tainted,
-	    &nx);
+	/*
+	 * A code signature may use 16K page hashes even when this kernel runs
+	 * with 4K pages (genuine iOS dyld shared cache / platform binaries).
+	 * A single 4K mapping cannot be compared to a 16K hash, so gather the
+	 * whole 16K block from the object's resident 4K pages via the permanent
+	 * 1-to-1 physical mapping (the same mapping vm_paging_map_object uses
+	 * for a single page). The object lock is held throughout, so the pages
+	 * are stable. If any page is absent, fall back to the one mapped page:
+	 * cs_validate_hash then fails securely (no validation, no taint).
+	 */
+	{
+		vm_object_offset_t      block_mo, block_obj;
+		vm_page_t               bpage[4];
+		char                    *block_buf = NULL;
+		const void              *vdata;
+		memory_object_offset_t  voff;
+		vm_size_t               vsize;
+		int                     i;
+
+		block_mo = mo_offset & ~((vm_object_offset_t)CS_16K_BLOCK_MASK);
+		/* paging_offset must be page-aligned and not above the block */
+		if ((object->paging_offset & PAGE_MASK_64) != 0 ||
+		    block_mo < object->paging_offset) {
+			block_obj = ~0ULL;   /* no full block available */
+		} else {
+			block_obj = block_mo - object->paging_offset;
+		}
+		for (i = 0; block_obj != ~0ULL && i < 4; i++) {
+			bpage[i] = vm_page_lookup(object, block_obj + (i << PAGE_SHIFT));
+			if (bpage[i] == VM_PAGE_NULL) {
+				break;
+			}
+		}
+		if (i == 4) {
+			/* non-blocking: do not sleep while holding the object lock */
+			block_buf = kalloc_data(CS_16K_BLOCK_SIZE, Z_NOWAIT);
+		}
+		if (block_buf != NULL) {
+			for (i = 0; i < 4; i++) {
+				vm_offset_t bva = (vm_map_offset_t)phystokv(
+				    (pmap_paddr_t)VM_PAGE_GET_PHYS_PAGE(bpage[i]) << PAGE_SHIFT);
+				memcpy(block_buf + (i << PAGE_SHIFT),
+				    (const void *)bva, PAGE_SIZE);
+			}
+			vdata = block_buf;
+			voff = block_mo;
+			vsize = CS_16K_BLOCK_SIZE;
+		} else {
+			vdata = (const void *)((const char *)kaddr);
+			voff = mo_offset;
+			vsize = PAGE_SIZE;
+		}
+
+		/* verify the code-directory hashes for this block */
+		validated = 0;
+		tainted = 0;
+		nx = 0;
+		cs_validate_page(vnode, pager, voff, vdata, vsize,
+		    &validated, &tainted, &nx);
+
+		if (block_buf != NULL) {
+			kfree_data(block_buf, CS_16K_BLOCK_SIZE);
+		}
+	}
 
 	page->vmp_cs_validated |= validated;
 	page->vmp_cs_tainted |= tainted;
