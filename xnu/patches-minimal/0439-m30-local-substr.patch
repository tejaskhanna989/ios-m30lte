@@ -840,6 +840,27 @@
  * slow heartbeat in vm_fault.c so a late pstore pull still sees it. */
 char m30_last_crash_reason[256];
 
+/* XNU kernel headers do not expose strstr(); use a bounded local search. */
+static bool
+m30_contains(const char *haystack, const char *needle)
+{
+	if (haystack == NULL || needle == NULL || *needle == '\0') {
+		return false;
+	}
+	for (const char *p = haystack; *p != '\0'; p++) {
+		const char *h = p;
+		const char *n = needle;
+		while (*h != '\0' && *n != '\0' && *h == *n) {
+			h++;
+			n++;
+		}
+		if (*n == '\0') {
+			return true;
+		}
+	}
+	return false;
+}
