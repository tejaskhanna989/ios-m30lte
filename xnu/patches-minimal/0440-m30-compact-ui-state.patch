diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -24,6 +24,7 @@
 extern task_t proc_task(proc_t);
 extern int hz;
 extern void sweet_sample_start(void);
+extern char m30_last_crash_reason[];   /* osfmk/kern/exception.c */
 
 static char sweet_sample_names[128];
 
@@ -61,6 +62,24 @@
 	return PROC_RETURNED;
 }
 
+/* v62: compact, frequent UI liveness line. Full backtraces below are kept
+ * but taken every fourth tick so they no longer overwrite the whole ring. */
+static int sweet_ui_sb_pid;
+static int sweet_ui_bb_pid;
+
+static int
+sweet_ui_proc(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (strcmp(name, "SpringBoard") == 0) {
+		sweet_ui_sb_pid = proc_pid(p);
+	} else if (strcmp(name, "backboardd") == 0) {
+		sweet_ui_bb_pid = proc_pid(p);
+	}
+	return PROC_RETURNED;
+}
+
 static void
 sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -71,11 +90,19 @@
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
-	for (int i = 0; i < 40; i++) {
-		printf("SMP --- sample %d\n", i);
-		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+	(void)tsleep(&chan, PZERO, "sweetsmp", 30 * hz);
+	for (int i = 0; i < 80; i++) {
+		sweet_ui_sb_pid = 0;
+		sweet_ui_bb_pid = 0;
+		proc_iterate(PROC_ALLPROCLIST, sweet_ui_proc, NULL, NULL, NULL);
+		printf("M30 UI: sb=%d bb=%d reason=%s\n",
+		    sweet_ui_sb_pid, sweet_ui_bb_pid,
+		    m30_last_crash_reason[0] != '\0' ? m30_last_crash_reason : "none");
+		if ((i % 4) == 0) {
+			printf("SMP --- sample %d\n", i / 4);
+			proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
+		}
+		(void)tsleep(&chan, PZERO, "sweetsmp", 30 * hz);
 	}
 }
 
