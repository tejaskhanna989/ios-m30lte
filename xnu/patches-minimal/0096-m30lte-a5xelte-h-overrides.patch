@@ -5,10 +5,30 @@
 #define NO_MONITOR                    1
 #define NO_ECORE                      1
 
+#if defined(ARM64_BOARD_CONFIG_M30LTE)
+/* Galaxy M30 SM-M305F (Exynos 7904): S-Boot leaves DECON_F scanning out
+ * this buffer; the loader's log page is 0x93fff000.
+ * Probe: S-Boot enters on the Cortex-A53 MPIDR 0x100. */
+#define M30LTE                        1
+#define A5XELTE                       1
+#define SWEET                         1
+#define SWEET_SMP_MAX_CPUS            1
+#define A5XELTE_FB_PA                 0xec000000
+#define A5XELTE_FB_WIDTH              1080
+#define A5XELTE_FB_HEIGHT             2340
+#define A5XELTE_FB_STRIDE             4320
+#define A5XELTE_FB_BLOCKS             5     /* 2 MiB VA=PA blocks: 10,108,800 bytes */
+#define A5XELTE_FB_TEXT_SCALE         2
+#define A5XELTE_FB_DOT_PITCH          409   /* 1080 pixels across 6.3 inches */
+#define A5XELTE_MARKER_PA             0x93fff100
+#define A5XELTE_BOOT_MPIDR            0x100
+#define A5XELTE_EMMC_PA               0x13500000
+#else
 #define A5XELTE                       1
 /* Reuse donor's SoC-neutral early services until their guards are renamed. */
 #define SWEET                         1
 #define SWEET_SMP_MAX_CPUS            1
+#endif
 
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__                  8
@@ -22,7 +42,9 @@
 
 /* Exynos7580 has a GICv2 distributor and CPU interface, not GICv3. */
