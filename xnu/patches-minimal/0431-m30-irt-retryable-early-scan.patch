+/* Record a scan failure.  A worker started from an early DSC-header fault is
+ * retried on a later DSC fault while the budget lasts; the terminal path keeps
+ * the v50 XCTEST fallback reachable.  No state check is weakened: only the
+ * read-only scan is restarted. */
+static void
+m30_irt_mark_failure(void)
+{
+	if (m30_irt_early_started &&
+	    m30_irt_early_attempts < M30_IRT_MAX_EARLY_ATTEMPTS) {
+		m30_irt_early_attempts++;
+		printf("M30 IRT: early scan attempt %d failed state=%d err=%d; "
+		    "rearming NEED_DSC\n", m30_irt_early_attempts,
+		    m30_irt_state, m30_irt_last_err);
+		m30_irt_state = M30_IRT_STATE_NEED_DSC;
+		m30_irt_file_offset = 0;
+		m30_irt_target_vp = (vnode_t)0;
+		m30_irt_sym_vmaddr = 0;
+		m30_irt_image_addr = 0;
+		m30_irt_base_map_cnt = 0;
+		m30_irt_base_map_addr = 0;
+		m30_irt_base_map_size = 0;
+		m30_irt_base_map_off = 0;
+		m30_irt_sym_map_cnt = 0;
+		m30_irt_sym_map_addr = 0;
+		m30_irt_sym_map_size = 0;
+		m30_irt_sym_map_fileoff = 0;
+		m30_irt_fallback_off = 0;
+		m30_irt_map_hits = 0;
+		m30_irt_map_tries = 0;
+		m30_irt_last_err = 0;
+		m30_irt_diag_seen = 0;
+		m30_irt_proactive_tries = 0;
+		m30_irt_proactive_result = 0;
+		m30_irt_thread_started = 0;
+		return;
+	}
+	printf("M30 IRT: scan failed terminally state=%d err=%d early=%d\n",
+	    m30_irt_state, m30_irt_last_err, m30_irt_early_started);
+	m30_irt_state = M30_IRT_STATE_FAILED;
+	m30_irt_thread_started = 0;   /* leave the v50 fallback able to restart */
+	m30_irt_early_started = 0;
+}
