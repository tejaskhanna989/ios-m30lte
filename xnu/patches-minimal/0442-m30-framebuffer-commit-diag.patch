 	}
 	m30_pmsg_emit(line, (uint32_t)n);
 }
+/* Direct, bounded pstore sink for M30LTE framebuffer diagnostics.
+ *
+ * a5fb_noconsole=1 sets sweet_console_muted after the first GUI present;
+ * _cnputs() then stops calling the serial/fbcon path, so ordinary IOLog()
+ * cannot reach the console->pmsg mirror. This function writes one already
+ * formatted short line straight into the same pmsg ring. It is M30LTE-only,
+ * non-blocking, allocates nothing, and never touches the serial console,
+ * userland memory, or any security state.
+ */
+void
+m30_pmsg_diag_line(const char *line)
+{
+	uint32_t len = 0;
+
+	if (line == NULL) {
+		return;
+	}
+	if (m30_pmsg_base == NULL) {
+		m30_pmsg_init();
+	}
+	while (line[len] != '\0' && len < sizeof(m30_line) - 1) {
+		len++;
+	}
+	while (len > 0 && (line[len - 1] == '\n' || line[len - 1] == '\r')) {
+		len--;
+	}
+	if (len != 0) {
+		m30_pmsg_emit((const uint8_t *)line, len);
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_M30LTE */
 
