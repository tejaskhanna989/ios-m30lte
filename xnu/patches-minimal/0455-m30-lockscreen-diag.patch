 extern char m30_last_crash_reason[];   /* osfmk/kern/exception.c */
 
+extern void m30_pmsg_diag_line(const char *line); /* pexpert/arm/pe_serial.c */
+
+/* v74 lock-screen diagnostic: read-only, bounded, disabled by default.
+ * m30sblockdiag=1 routes the existing SMP sampler into the durable pmsg sink
+ * so SpringBoard scene-creation backtraces survive the 16 KiB ring wrap. */
+int m30_ls_diag_enabled;
+void m30_ls_diag_line(const char *line) { m30_pmsg_diag_line(line); }
+
 static char sweet_sample_names[128];
 
 static bool
@@ -106,10 +114,39 @@
 	}
 }
 
+/* Bounded durable sampler. No state changes, no injection, no UI code patched.
+ * First sample 45 s after start, then every 60 s, at most 6 samples. */
+static void
+m30_ls_diag_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	char names[64];
+	(void)strlcpy(names, "SpringBoard,backboardd", sizeof(names));
+	(void)tsleep(&chan, PZERO, "m30lsdiag", 45 * hz);
+	for (int i = 0; i < 6; i++) {
+		char line[96];
+		(void)snprintf(line, sizeof(line), "M30 LS DIAG sample %d", i);
+		m30_pmsg_diag_line(line);
+		(void)strlcpy(sweet_sample_names, names, sizeof(sweet_sample_names));
+		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
+		(void)tsleep(&chan, PZERO, "m30lsdiag", 60 * hz);
+	}
+	m30_ls_diag_enabled = 0;
+	m30_pmsg_diag_line("M30 LS DIAG stopped after 6 samples");
+}
+
 void
 sweet_sample_start(void)
 {
 	thread_t thread;
+	int lsdiag = 0;
+	(void)PE_parse_boot_argn("m30sblockdiag", &lsdiag, sizeof(lsdiag));
+	if (lsdiag) {
+		m30_ls_diag_enabled = 1;
+		if (kernel_thread_start(m30_ls_diag_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
 	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
