diff --git a/bsd/kern/ubc_subr.c b/bsd/kern/ubc_subr.c
--- a/bsd/kern/ubc_subr.c
+++ b/bsd/kern/ubc_subr.c
@@ -5735,7 +5735,18 @@
 			if (hashtype->cs_digest_size > sizeof(actual_hash)) {
 				panic("hash size too large");
 			}
-			if (offset & ((1U << blob->csb_hash_pageshift) - 1)) {
+			if (blob->csb_hash_pageshift > PAGE_SHIFT) {
+				/*
+				 * 16K code directory on a 4K-page kernel: the fault
+				 * offset is only 4K aligned. Round down to the CD hash
+				 * boundary so the correct first-level hash is selected.
+				 * The hash below is bounded to the single mapped VM page
+				 * (no overread); a 4K chunk cannot match a 16K hash, so
+				 * the page is conservatively marked tainted, never falsely
+				 * validated. Existing cs_invalid_page policy still decides.
+				 */
+				offset &= ~((off_t)((1U << blob->csb_hash_pageshift) - 1));
+			} else if (offset & ((1U << blob->csb_hash_pageshift) - 1)) {
 				panic("offset not aligned to cshash boundary");
 			}
 
@@ -5774,6 +5785,10 @@
 		*tainted = 0;
 
 		size = (1U << blob->csb_hash_pageshift);
+		if (size > PAGE_SIZE) {
+			/* only one VM page is mapped for validation */
+			size = PAGE_SIZE;
+		}
 		*bytes_processed = size;
 
 		const uint32_t *asha1, *esha1;
