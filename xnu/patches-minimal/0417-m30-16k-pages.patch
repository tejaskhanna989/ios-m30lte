diff --git a/pexpert/pexpert/arm64/M30LTE.h b/pexpert/pexpert/arm64/M30LTE.h
--- a/pexpert/pexpert/arm64/M30LTE.h
+++ b/pexpert/pexpert/arm64/M30LTE.h
@@ -20,6 +20,15 @@
 #define __ARM_V8_CRYPTO_EXTENSIONS__  1
 #define __ARM_PAN_AVAILABLE__         0
 
+/*
+ * Genuine iOS 16.7.16 (iPhone10,3 / D22) uses 16K pages. Match it so the
+ * dyld shared cache (signed for 16K pages) validates and maps natively:
+ * the TCR translation granule and ARM_PGSHIFT are compile-time and must be
+ * 16K. SWEET.h does the same. Without this the 4K kernel rejects/taints the
+ * 16K code directory and daemon text pages get killed in a crash loop.
+ */
+#define __ARM_16K_PG__               1
+
 /* Exynos7904 has a GICv2 distributor and CPU interface, not GICv3. */
 #define HAS_GIC_V3                    0
 #define M30LTE_VTIMER_INTID          27
